{"schemaVersion":2,"id":"umar","gender":"male","name":{"ar":"عمر بن الخطاب"},"fullName":{"ar":"عمر بن الخطاب بن نفيل القرشي العدوي"},"summary":{"ar":"ثاني الخلفاء الراشدين، وأحد العشرة المبشرين بالجنة، ومن المهاجرين."},"review":{"status":"preliminaryReview","editorialFlags":["needsLocators"],"coverage":"complete"},"references":["isabah","siyar","istiab","usd-al-ghabah","tabaqat-ibn-sad"],"order":2,"lineage":{"ar":"من بني عدي بن كعب، من قريش"},"kunya":{"ar":"أبو حفص"},"titles":[{"ar":"الفاروق"}],"aliases":["عمر الفاروق","ابو حفص"],"death":{"date":{"precision":"year","era":"afterHijra","hijriYear":23,"gregorianYear":644},"reliability":"established","citations":[{"sourceId":"tabaqat-ibn-sad","locatorStatus":"complete","volume":3,"page":"251"},{"sourceId":"tarikh-al-tabari","locatorStatus":"complete","volume":4,"page":"193"}]},"deathPlace":{"ar":"المدينة المنورة"},"atAGlance":[{"label":{"ar":"الخلافة"},"reliability":"established","date":{"precision":"range","era":"afterHijra","hijriYear":13,"gregorianYear":634,"hijriYearEnd":23,"gregorianYearEnd":644},"citations":[{"sourceId":"tarikh-al-tabari","locatorStatus":"complete","volume":4,"page":"193"}]},{"label":{"ar":"مدفنه"},"reliability":"established","text":{"ar":"إلى جانب النبي ﷺ وأبي بكر بالمدينة"},"citations":[{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"3700"}]}],"memberships":[{"categoryId":"ashara-mubashshara","citations":[{"sourceId":"tirmidhi","locatorStatus":"complete","hadithNumber":"3747"},{"sourceId":"abu-dawud","locatorStatus":"complete","hadithNumber":"4649"}]},{"categoryId":"khulafa-rashidun","citations":[{"sourceId":"tarikh-al-tabari","locatorStatus":"complete","volume":3,"page":"428"}]},{"categoryId":"muhajirun","citations":[{"sourceId":"sirat-ibn-hisham","locatorStatus":"complete","volume":1,"page":"474"}]},{"categoryId":"ahl-badr","citations":[{"sourceId":"sirat-ibn-hisham","locatorStatus":"complete","volume":1,"page":"683"}]}],"relations":[{"type":"child","person":{"displayName":{"ar":"حفصة أم المؤمنين"},"companionId":"hafsa"},"citations":[{"sourceId":"isabah","locatorStatus":"complete","volume":7,"page":"581"}]},{"type":"sibling","person":{"displayName":{"ar":"فاطمة بنت الخطاب"},"personId":"fatimah-bint-al-khattab"},"citations":[{"sourceId":"tabaqat-ibn-sad","locatorStatus":"complete","volume":8,"page":"209"}]}],"sections":[{"id":"umar.early-life","kind":"earlyLife","title":{"ar":"النشأة"},"blocks":[{"text":{"ar":"هو عمر بن الخطاب بن نفيل، من بني عدي بن كعب من قريش، يلتقي نسبه بنسب النبي ﷺ في كعب بن لؤي، ويُكنى أبا حفص."},"reliability":"established","citations":[{"sourceId":"isabah","locatorStatus":"complete","volume":4,"page":"588"},{"sourceId":"tabaqat-ibn-sad","locatorStatus":"complete","volume":3,"page":"201"}],"type":"paragraph"},{"text":{"ar":"وُلد بمكة بعد عام الفيل بنحو ثلاث عشرة سنة على ما يذكره أهل التراجم، وفي ذلك أقوال أخرى."},"reliability":"reported","citations":[{"sourceId":"tabaqat-ibn-sad","locatorStatus":"complete","volume":3,"page":"204"},{"sourceId":"istiab","locatorStatus":"complete","volume":3,"page":"1145"}],"type":"paragraph"},{"text":{"ar":"ونشأ في شظف من العيش، يرعى إبل أبيه في صباه ويحتطب عليها، وذكر بعد ذلك أن أباه كان فظًّا غليظًا."},"reliability":"reported","citations":[{"sourceId":"tabaqat-ibn-sad","locatorStatus":"complete","volume":3,"page":"202"},{"sourceId":"isabah","locatorStatus":"complete","volume":4,"page":"588"}],"type":"paragraph"},{"text":{"ar":"وكانت قريش تجعل إليه السفارة في الجاهلية، فإذا وقعت بينها وبين غيرها حرب أو منافرة بعثته رسولًا عنها."},"reliability":"reported","citations":[{"sourceId":"istiab","locatorStatus":"complete","volume":3,"page":"1145"}],"type":"paragraph"},{"text":{"ar":"وتزوّج في الجاهلية زينب بنت مظعون، فولدت له عبد الله وحفصة، وكان لعبد الله بن عمر بعد ذلك شأن كبير في العلم والرواية، وصارت حفصة أمًّا للمؤمنين."},"reliability":"reported","citations":[{"sourceId":"tabaqat-ibn-sad","locatorStatus":"complete","volume":3,"page":"201"},{"sourceId":"isabah","locatorStatus":"complete","volume":4,"page":"181"}],"type":"paragraph"}]},{"id":"umar.conversion","kind":"conversion","title":{"ar":"إسلامه"},"blocks":[{"text":{"ar":"أسلم بمكة قبل الهجرة، وكان إسلامه قوةً للمسلمين."},"reliability":"established","citations":[{"sourceId":"isabah","locatorStatus":"complete","volume":4,"page":"588"},{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"3863"}],"type":"paragraph"},{"textStatus":"complete","reliability":"established","citations":[{"sourceId":"tirmidhi","locatorStatus":"complete","hadithNumber":"3681","grading":{"grade":"sahih","gradedBy":{"ar":"الترمذي، وقال: حسن صحيح غريب"}}}],"text":{"ar":"اللَّهُمَّ أَعِزَّ الإِسْلاَمَ بِأَحَبِّ هَذَيْنِ الرَّجُلَيْنِ إِلَيْكَ بِأَبِي جَهْلٍ أَوْ بِعُمَرَ بْنِ الْخَطَّابِ"},"summary":{"ar":"حديث في دعاء النبي ﷺ أن يعزّ الله الإسلام بأحب الرجلين إليه: عمر بن الخطاب أو أبي جهل، فكان أحبهما إلى الله عمر."},"type":"hadithQuote"},{"text":{"ar":"وكان قبل إسلامه يشتدّ على من أسلم من أهله، حتى ذكر سعيد بن زيد، زوج أخته فاطمة، أن عمر أوثقه على الإسلام قبل أن يسلم عمر."},"reliability":"established","citations":[{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"3862"},{"sourceId":"sirat-ibn-hisham","locatorStatus":"complete","volume":1,"page":"342"}],"type":"paragraph"},{"text":{"ar":"وكانت أخته فاطمة بنت الخطاب وزوجها سعيد بن زيد قد سبقاه إلى الإسلام."},"reliability":"reported","citations":[{"sourceId":"sirat-ibn-hisham","locatorStatus":"complete","volume":1,"page":"254"},{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"3862"}],"type":"paragraph"},{"text":{"ar":"ويروي أهل السير أنه سمع القرآن في بيت أخته فرقّ قلبه، ثم ذهب إلى النبي ﷺ في دار الأرقم فأسلم، وفي أسانيد هذه القصة بتفاصيلها كلام عند أهل الحديث."},"reliability":"reported","citations":[{"sourceId":"sirat-ibn-hisham","locatorStatus":"complete","volume":1,"page":"344"},{"sourceId":"al-bidaya","locatorStatus":"complete","volume":4,"page":"197"}],"type":"paragraph"},{"text":{"ar":"وكان إسلامه بعد خروج من خرج من الصحابة إلى الحبشة، على ما يذكر ابن إسحاق، وبعد إسلام حمزة بن عبد المطلب؛ ويروي ابن سعد عن سعيد بن المسيب أنه أسلم بعد أربعين رجلًا وعشر نسوة."},"reliability":"reported","citations":[{"sourceId":"tabaqat-ibn-sad","locatorStatus":"complete","volume":3,"page":"204"},{"sourceId":"sirat-ibn-hisham","locatorStatus":"complete","volume":1,"page":"346"},{"sourceId":"sirat-ibn-hisham","locatorStatus":"complete","volume":1,"page":"342"}],"type":"paragraph"},{"textStatus":"complete","reliability":"established","citations":[{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"3863"}],"text":{"ar":"مَا زِلْنَا أَعِزَّةً مُنْذُ أَسْلَمَ عُمَرُ"},"summary":{"ar":"قول عبد الله بن مسعود في أثر إسلام عمر في عزّة المسلمين."},"type":"reportQuote"},{"text":{"ar":"وبعد إسلامه أعلن المسلمون صلاتهم عند الكعبة، وكانوا قبل ذلك يستخفون بها."},"reliability":"reported","citations":[{"sourceId":"tabaqat-ibn-sad","locatorStatus":"complete","volume":3,"page":"204"},{"sourceId":"sirat-ibn-hisham","locatorStatus":"complete","volume":1,"page":"342"}],"type":"paragraph"},{"text":{"ar":"ولما شاع إسلامه اجتمع الناس عند داره يريدونه بسوء، فجاءه العاص بن وائل السهمي فأجاره، فانصرف الناس عنه، كما رواه ابنه عبد الله بن عمر، وكان يومئذ غلامًا يشهد ما جرى."},"reliability":"established","citations":[{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"3864"}],"type":"paragraph"}]},{"id":"umar.with-prophet","kind":"withProphet","title":{"ar":"مع النبي ﷺ"},"blocks":[{"text":{"ar":"هاجر عمر إلى المدينة قبل النبي ﷺ مع من هاجر من الصحابة، ونزل بها في عوالي المدينة."},"reliability":"established","citations":[{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"3925"},{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"89"},{"sourceId":"sirat-ibn-hisham","locatorStatus":"complete","volume":1,"page":"474"}],"type":"paragraph"},{"text":{"ar":"وكان حريصًا على العلم؛ فذكر أنه كان يتناوب مع جار له من الأنصار النزول إلى النبي ﷺ، ينزل هذا يومًا وذاك يومًا، فيخبر كلٌّ صاحبه بما سمع من الوحي وغيره."},"reliability":"established","citations":[{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"89"}],"type":"paragraph"},{"text":{"ar":"وشهد بدرًا وأحدًا والخندق والمشاهد كلها مع النبي ﷺ، كما يذكر ابن سعد؛ ويوم أحد أمره النبي ﷺ أن يجيب أبا سفيان حين نادى من الجبل، ويوم حنين كان فيمن ثبت معه حين انهزم الناس."},"reliability":"established","citations":[{"sourceId":"sirat-ibn-hisham","locatorStatus":"complete","volume":2,"page":"93"},{"sourceId":"tabaqat-ibn-sad","locatorStatus":"complete","volume":3,"page":"206"},{"sourceId":"sirat-ibn-hisham","locatorStatus":"complete","volume":2,"page":"443"}],"type":"paragraph"},{"text":{"ar":"وكان له رأي في مواضع نزل القرآن موافقًا له، منها اتخاذ مقام إبراهيم مصلًّى، والحجاب لأمهات المؤمنين، وأمر أسرى بدر، كما ذكر ذلك هو عن نفسه."},"reliability":"established","citations":[{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"402"},{"sourceId":"muslim","locatorStatus":"complete","hadithNumber":"2399"},{"sourceId":"quran","locatorStatus":"complete","quranRef":{"surah":2,"ayahFrom":125}},{"sourceId":"muslim","locatorStatus":"complete","hadithNumber":"1763"},{"sourceId":"quran","locatorStatus":"complete","quranRef":{"surah":8,"ayahFrom":67,"ayahTo":68}}],"type":"paragraph"},{"text":{"ar":"ولما توفي زوج ابنته حفصة عرضها على عثمان ثم على أبي بكر، ثم خطبها النبي ﷺ فتزوجها، فصارت أمًّا للمؤمنين."},"reliability":"established","citations":[{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"4005"}],"type":"paragraph"},{"text":{"ar":"وفي الحديبية سأل النبي ﷺ عن شروط الصلح التي رآها شديدة، ثم سأل أبا بكر، فأجابه بمثل جواب النبي ﷺ؛ وقال عمر بعدُ: «فعملت لذلك أعمالًا»."},"reliability":"established","citations":[{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"2731"}],"type":"paragraph"},{"text":{"ar":"وأصاب أرضًا بخيبر كانت أنفس ماله عنده، فاستشار النبي ﷺ فيها، فأشار عليه أن يحبس أصلها ويتصدق بها، فجعلها صدقة لا تُباع ولا تُوهب ولا تُورث، في الفقراء وذوي القربى وفي الرقاب وفي سبيل الله وابن السبيل والضيف."},"reliability":"established","citations":[{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"2737"},{"sourceId":"muslim","locatorStatus":"complete","hadithNumber":"1632"}],"type":"paragraph"},{"text":{"ar":"وتروي السنن أن النبي ﷺ أمر أصحابه بالصدقة، فجاء عمر بنصف ماله يرجو أن يسبق أبا بكر، وجاء أبو بكر بكل ما عنده، فقال عمر إنه لا يسبقه إلى شيء أبدًا."},"reliability":"reported","citations":[{"sourceId":"tirmidhi","locatorStatus":"complete","hadithNumber":"3675"},{"sourceId":"abu-dawud","locatorStatus":"complete","hadithNumber":"1678"}],"type":"paragraph"},{"text":{"ar":"وفي مرض النبي ﷺ الأخير، حين غاب أبو بكر مرة، تقدّم عمر ليصلي بالناس، فلما سمع النبي ﷺ صوته أبى إلا أن يصلي بهم أبو بكر، على ما في رواية أبي داود."},"reliability":"reported","citations":[{"sourceId":"abu-dawud","locatorStatus":"complete","hadithNumber":"4660"}],"type":"paragraph"},{"text":{"ar":"ولما توفي النبي ﷺ اشتد على عمر الخبر حتى أنكر موته، فجاء أبو بكر فخطب الناس وتلا آية آل عمران، فذكر عمر أنه حين سمعها عرف أن النبي ﷺ قد مات."},"reliability":"established","citations":[{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"3667"},{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"4454"},{"sourceId":"quran","locatorStatus":"complete","quranRef":{"surah":3,"ayahFrom":144}}],"type":"paragraph"}]},{"id":"umar.virtues","kind":"virtues","title":{"ar":"فضائله"},"blocks":[{"text":{"ar":"لُقّب بالفاروق."},"reliability":"reported","citations":[{"sourceId":"tabaqat-ibn-sad","locatorStatus":"complete","volume":3,"page":"205"}],"type":"paragraph"},{"textStatus":"complete","reliability":"established","citations":[{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"3683","grading":{"grade":"sahih","gradedBy":{"ar":"البخاري، بإخراجه في صحيحه"}}},{"sourceId":"muslim","locatorStatus":"complete","hadithNumber":"2396","grading":{"grade":"sahih","gradedBy":{"ar":"مسلم، بإخراجه في صحيحه"}}}],"text":{"ar":"مَا لَقِيَكَ الشَّيْطَانُ سَالِكًا فَجًّا قَطُّ إِلاَّ سَلَكَ فَجًّا غَيْرَ فَجِّكَ"},"summary":{"ar":"حديث النبي ﷺ لعمر أن الشيطان ما لقيه سالكًا طريقًا إلا سلك طريقًا غير طريقه."},"type":"hadithQuote"},{"textStatus":"complete","reliability":"established","citations":[{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"82","grading":{"grade":"sahih","gradedBy":{"ar":"البخاري، بإخراجه في صحيحه"}}},{"sourceId":"muslim","locatorStatus":"complete","hadithNumber":"2391","grading":{"grade":"sahih","gradedBy":{"ar":"مسلم، بإخراجه في صحيحه"}}}],"text":{"ar":"بَيْنَا أَنَا نَائِمٌ أُتِيتُ بِقَدَحِ لَبَنٍ، فَشَرِبْتُ حَتَّى إِنِّي لأَرَى الرِّيَّ يَخْرُجُ فِي أَظْفَارِي، ثُمَّ أَعْطَيْتُ فَضْلِي عُمَرَ بْنَ الْخَطَّابِ ‏\"‏‏.‏ قَالُوا فَمَا أَوَّلْتَهُ يَا رَسُولَ اللَّهِ قَالَ ‏\"‏ الْعِلْمَ"},"summary":{"ar":"حديث النبي ﷺ في رؤيا اللبن الذي شرب منه ثم أعطى فضله عمر، وتأويله ذلك بالعلم."},"type":"hadithQuote"},{"textStatus":"complete","reliability":"established","citations":[{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"3680","grading":{"grade":"sahih","gradedBy":{"ar":"البخاري، بإخراجه في صحيحه"}}},{"sourceId":"muslim","locatorStatus":"complete","hadithNumber":"2394","grading":{"grade":"sahih","gradedBy":{"ar":"مسلم، بإخراجه في صحيحه"}}}],"text":{"ar":"بَيْنَا أَنَا نَائِمٌ رَأَيْتُنِي فِي الْجَنَّةِ، فَإِذَا امْرَأَةٌ تَتَوَضَّأُ إِلَى جَانِبِ قَصْرٍ، فَقُلْتُ لِمَنْ هَذَا الْقَصْرُ قَالُوا لِعُمَرَ فَذَكَرْتُ غَيْرَتَهُ فَوَلَّيْتُ مُدْبِرًا ‏\"‏‏.‏ فَبَكَى وَقَالَ أَعَلَيْكَ أَغَارُ يَا رَسُولَ اللَّهِ"},"summary":{"ar":"حديث النبي ﷺ في رؤياه قصرًا في الجنة لعمر، وذكره غيرة عمر."},"type":"hadithQuote"},{"textStatus":"complete","reliability":"established","citations":[{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"3689","grading":{"grade":"sahih","gradedBy":{"ar":"البخاري، بإخراجه في صحيحه"}}}],"text":{"ar":"لَقَدْ كَانَ فِيمَا قَبْلَكُمْ مِنَ الأُمَمِ مُحَدَّثُونَ، فَإِنْ يَكُ فِي أُمَّتِي أَحَدٌ فَإِنَّهُ عُمَرُ"},"summary":{"ar":"حديث النبي ﷺ في أنه إن كان في هذه الأمة مُحدَّثون فعمر منهم."},"type":"hadithQuote"},{"textStatus":"complete","reliability":"established","citations":[{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"402"}],"text":{"ar":"وَافَقْتُ رَبِّي فِي ثَلاَثٍ"},"summary":{"ar":"قول عمر إنه وافق ربه في مواضع نزل فيها القرآن موافقًا لرأيه."},"type":"reportQuote"},{"text":{"ar":"وهو أحد العشرة الذين سمّاهم النبي ﷺ في حديث واحد وبشّرهم بالجنة."},"reliability":"established","citations":[{"sourceId":"tirmidhi","locatorStatus":"complete","hadithNumber":"3747"},{"sourceId":"abu-dawud","locatorStatus":"complete","hadithNumber":"4649"}],"type":"paragraph"},{"text":{"ar":"ولما وُضع على سريره بعد موته وقف علي بن أبي طالب يترحّم عليه، وذكر أنه طالما سمع النبي ﷺ يقرن ذكره بذكر أبي بكر، وأنه كان يرجو أن يجعله الله مع صاحبيه."},"reliability":"established","citations":[{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"3685"},{"sourceId":"muslim","locatorStatus":"complete","hadithNumber":"2389"}],"type":"paragraph"},{"text":{"ar":"وكان من فقهاء الصحابة، ويروي ابن سعد عن رجل من أهل المدينة أنه رأى الفقهاء عند عمر مثل الصبيان، قد استعلى عليهم في فقهه وعلمه."},"reliability":"reported","citations":[{"sourceId":"tabaqat-ibn-sad","locatorStatus":"complete","volume":2,"page":"256"}],"type":"paragraph"},{"text":{"ar":"ووصف عبد الله بن مسعود أثره في ثلاث مراحل: كان إسلامه فتحًا للمسلمين، وكانت هجرته نصرًا لهم، وكانت ولايته رحمة بهم، على ما يرويه ابن سعد وغيره."},"reliability":"reported","citations":[{"sourceId":"tabaqat-ibn-sad","locatorStatus":"complete","volume":3,"page":"204"}],"type":"paragraph"}]},{"id":"umar.character","kind":"character","title":{"ar":"عدله وسيرته في الناس"},"blocks":[{"text":{"ar":"كان يحاسب ولاته؛ فيذكر الطبري أنه كان يقتصّ من عمّاله، وإذا شُكي إليه عامل جمع بينه وبين من شكاه، ويذكر ابن سعد أنه كان يأمر عمّاله أن يوافوه في موسم الحج ليسمع ما يقال فيهم."},"reliability":"reported","citations":[{"sourceId":"tarikh-al-tabari","locatorStatus":"complete","volume":4,"page":"204"},{"sourceId":"tabaqat-ibn-sad","locatorStatus":"complete","volume":3,"page":"223"}],"type":"paragraph"},{"text":{"ar":"ويروي ابن سعد عن ابن عمر أن أباه كان يقوت نفسه وأهله، وربما خرق إزاره فرقعه، وأن كسوته في العام الذي يكثر فيه المال كانت أدنى من كسوته في العام الذي قبله."},"reliability":"reported","citations":[{"sourceId":"tabaqat-ibn-sad","locatorStatus":"complete","volume":3,"page":"234"}],"type":"paragraph"},{"text":{"ar":"وفي عام الرمادة، حين أصاب الناس جدب شديد سنة ثماني عشرة، حلف ألا يذوق لحمًا ولا سمنًا حتى يحيا الناس، كما يرويه ابن سعد."},"reliability":"reported","citations":[{"sourceId":"tarikh-al-tabari","locatorStatus":"complete","volume":4,"page":"96"},{"sourceId":"tabaqat-ibn-sad","locatorStatus":"complete","volume":3,"page":"215"},{"sourceId":"tabaqat-ibn-sad","locatorStatus":"complete","volume":3,"page":"238"}],"type":"paragraph"},{"text":{"ar":"وكان يستشير أهل العلم من الصحابة في النوازل، ويرجع إلى الحق إذا تبيّن له."},"reliability":"reported","citations":[{"sourceId":"tarikh-al-tabari","locatorStatus":"complete","volume":4,"page":"57"},{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"5729"}],"type":"paragraph"},{"text":{"ar":"وتُروى عنه أخبار كثيرة في تفقّد الرعية ليلًا وقضاء حوائج الأرامل والأيتام، وفي أسانيد بعضها كلام؛ والثابت من سيرته في ذلك كثير يغني عن المكذوب."},"reliability":"reported","citations":[{"sourceId":"tarikh-al-tabari","locatorStatus":"complete","volume":4,"page":"205"}],"type":"paragraph"},{"text":{"ar":"ومن وصيته عند موته أن يوفى لأهل الذمة بعهدهم، وأن يقاتل من وراءهم، ولا يكلّفوا فوق طاقتهم، وأوصى بالمهاجرين والأنصار والأعراب خيرًا."},"reliability":"established","citations":[{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"3700"}],"type":"paragraph"},{"text":{"ar":"وحين جعل الأمر شورى في الستة قال: «يشهدكم عبد الله بن عمر وليس له من الأمر شيء»، قال الراوي: كهيئة التعزية له."},"reliability":"established","citations":[{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"3700"}],"type":"paragraph"},{"text":{"ar":"وشكا بعض أهل الكوفة واليهم سعد بن أبي وقاص، فعزله عمر وولّى عليهم عمارًا، ثم سأل سعدًا عمّا قالوه في صلاته، فلما أخبره قال: «ذاك الظن بك يا أبا إسحاق»، وبعث من يسأل عنه في مساجد الكوفة، فأثنوا عليه إلا رجلًا واحدًا؛ وذكر عمر عند موته أنه لم يعزله عن عجز ولا خيانة، وجعله في أهل الشورى."},"reliability":"established","citations":[{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"755"},{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"3700"}],"type":"paragraph"},{"text":{"ar":"وعزل خالد بن الوليد عن إمرة الجيش بالشام أول ما ولي، وضمّ الأمراء إلى أبي عبيدة بن الجراح؛ ويروي سيف بن عمر أنه كتب بعدُ إلى الأمصار: «إني لم أعزل خالدًا عن سخطة ولا خيانة، ولكن الناس فُتنوا به، فأحببت أن يعلموا أن الله هو الصانع»."},"reliability":"reported","citations":[{"sourceId":"tarikh-al-tabari","locatorStatus":"complete","volume":3,"page":"434"},{"sourceId":"tarikh-al-tabari","locatorStatus":"complete","volume":4,"page":"68"},{"sourceId":"al-bidaya","locatorStatus":"complete","volume":10,"page":"47"}],"type":"paragraph"},{"text":{"ar":"وتزوّج أم كلثوم بنت علي بن أبي طالب من فاطمة بنت النبي ﷺ، وكان يقول: «أقضانا عليّ»."},"reliability":"reported","citations":[{"sourceId":"isabah","locatorStatus":"complete","volume":8,"page":"293"},{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"2881"},{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"4481"}],"type":"paragraph"}]},{"id":"umar.caliphate","kind":"contributions","title":{"ar":"خلافته"},"blocks":[{"text":{"ar":"تولّى الخلافة بعهدٍ من أبي بكر سنة ثلاث عشرة للهجرة."},"reliability":"established","citations":[{"sourceId":"tarikh-al-tabari","locatorStatus":"complete","volume":3,"page":"428"},{"sourceId":"al-bidaya","locatorStatus":"complete","volume":9,"page":"574"}],"type":"paragraph"},{"text":{"ar":"وكان أول من دُعي بأمير المؤمنين على ما يذكره المؤرخون، بعد أن كان أبو بكر يُدعى خليفة رسول الله."},"reliability":"reported","citations":[{"sourceId":"tarikh-al-tabari","locatorStatus":"complete","volume":4,"page":"208"}],"type":"paragraph"},{"text":{"ar":"وفي خلافته كانت الوقائع الكبرى مع الروم في الشام، ومنها اليرموك، ومع الفرس في العراق، ومنها القادسية بقيادة سعد بن أبي وقاص، واختلف المؤرخون في سنواتها بين الثالثة عشرة والسادسة عشرة."},"reliability":"reported","citations":[{"sourceId":"tarikh-al-tabari","locatorStatus":"complete","volume":3,"page":"384"},{"sourceId":"tarikh-al-tabari","locatorStatus":"complete","volume":3,"page":"516"},{"sourceId":"al-bidaya","locatorStatus":"complete","volume":9,"page":"545"},{"sourceId":"al-bidaya","locatorStatus":"complete","volume":9,"page":"629"}],"type":"paragraph"},{"text":{"ar":"ثم سار بنفسه إلى الشام حين صالح أهلُ بيت المقدس على تسليمها، فكتب لهم الأمان على أنفسهم وكنائسهم."},"reliability":"reported","citations":[{"sourceId":"tarikh-al-tabari","locatorStatus":"complete","volume":3,"page":"608"},{"sourceId":"al-bidaya","locatorStatus":"complete","volume":9,"page":"584"}],"type":"paragraph"},{"text":{"ar":"وفتح عمرو بن العاص مصر في عهده، ومُصّرت البصرة والكوفة لتكونا قاعدتين للمسلمين في العراق."},"reliability":"reported","citations":[{"sourceId":"tarikh-al-tabari","locatorStatus":"complete","volume":4,"page":"102"},{"sourceId":"tarikh-al-tabari","locatorStatus":"complete","volume":3,"page":"592"},{"sourceId":"al-bidaya","locatorStatus":"complete","volume":10,"page":"85"},{"sourceId":"al-bidaya","locatorStatus":"complete","volume":9,"page":"641"},{"sourceId":"tarikh-al-tabari","locatorStatus":"complete","volume":3,"page":"384"},{"sourceId":"tarikh-al-tabari","locatorStatus":"complete","volume":3,"page":"516"},{"sourceId":"al-bidaya","locatorStatus":"complete","volume":9,"page":"545"},{"sourceId":"al-bidaya","locatorStatus":"complete","volume":9,"page":"629"}],"type":"paragraph"},{"text":{"ar":"ولم تكن الفتوح كلها نصرًا؛ فقد أصاب المسلمين في العراق يوم الجسر مصاب كبير قبل القادسية، ثم كانت وقعة نهاوند سنة إحدى وعشرين، وسمّاها المؤرخون فتح الفتوح لما تلاها من انفتاح بلاد فارس."},"reliability":"reported","citations":[{"sourceId":"tarikh-al-tabari","locatorStatus":"complete","volume":3,"page":"442"},{"sourceId":"tarikh-al-tabari","locatorStatus":"complete","volume":4,"page":"114"},{"sourceId":"al-bidaya","locatorStatus":"complete","volume":9,"page":"596"},{"sourceId":"al-bidaya","locatorStatus":"complete","volume":10,"page":"111"}],"type":"paragraph"},{"text":{"ar":"ودوّن الدواوين، فجعل للناس عطاءً من بيت المال، ورتّبهم على السابقة في الإسلام."},"reliability":"reported","citations":[{"sourceId":"tarikh-al-tabari","locatorStatus":"complete","volume":3,"page":"614"},{"sourceId":"tabaqat-ibn-sad","locatorStatus":"complete","volume":3,"page":"214"}],"type":"paragraph"},{"text":{"ar":"وجمع الناس في قيام رمضان على قارئ واحد هو أبي بن كعب بعد أن كانوا يصلّون متفرقين."},"reliability":"established","citations":[{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"2010"}],"type":"paragraph"},{"text":{"ar":"وفي خلافته كُتب التاريخ من الهجرة؛ ويروي الطبري عن سعيد بن المسيب أن عمر كتبه سنة ست عشرة بمشورة علي بن أبي طالب."},"reliability":"reported","citations":[{"sourceId":"tarikh-al-tabari","locatorStatus":"complete","volume":4,"page":"38"},{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"3934"}],"type":"paragraph"},{"text":{"ar":"ووسّع المسجد النبوي حين ضاق بالناس، وبناه على البناء الذي كان على عهد النبي ﷺ: اللبن والجريد وجذوع النخل."},"reliability":"established","citations":[{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"446"}],"type":"paragraph"},{"text":{"ar":"وولّى القضاة في الأمصار، ويذكر ابن سعد أنه فرض العطاء حتى للمولود حين يولد."},"reliability":"reported","citations":[{"sourceId":"tabaqat-ibn-sad","locatorStatus":"complete","volume":3,"page":"214"},{"sourceId":"tabaqat-ibn-sad","locatorStatus":"complete","volume":3,"page":"226"}],"type":"paragraph"},{"text":{"ar":"ونظّم بيت المال وأموال الخراج في البلاد المفتوحة، فأبقى الأرض في أيدي أهلها يؤدّون خراجها، ليكون موردًا دائمًا للمسلمين ومن بعدهم."},"reliability":"reported","citations":[{"sourceId":"tarikh-al-tabari","locatorStatus":"complete","volume":4,"page":"33"},{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"2334"}],"type":"paragraph"},{"text":{"ar":"ولما خرج إلى الشام سنة سبع عشرة بلغه أن الطاعون قد وقع بها، فاستشار المهاجرين والأنصار، ثم رجع بالناس، وأخبره عبد الرحمن بن عوف بحديث النبي ﷺ في ألا يُقدم على أرض وقع بها الطاعون؛ وكان أبو عبيدة بن الجراح ممن مات في ذلك الطاعون."},"reliability":"established","citations":[{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"5729"},{"sourceId":"muslim","locatorStatus":"complete","hadithNumber":"2219"}],"type":"paragraph"}]},{"id":"umar.death","kind":"death","title":{"ar":"وفاته"},"blocks":[{"text":{"ar":"طُعن وهو يصلي بالناس صلاة الفجر في ذي الحجة سنة ثلاث وعشرين للهجرة، وتوفي بعد أيام."},"reliability":"established","citations":[{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"3700"},{"sourceId":"tarikh-al-tabari","locatorStatus":"complete","volume":4,"page":"193"}],"type":"paragraph"},{"text":{"ar":"وكان الذي طعنه غلامًا للمغيرة بن شعبة يُعرف بأبي لؤلؤة، فحُمل عمر إلى بيته، وسأل عمّن طعنه، فحمد الله أنه لم يكن رجلًا من المسلمين يحاجّه."},"reliability":"established","citations":[{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"3700"},{"sourceId":"tabaqat-ibn-sad","locatorStatus":"complete","volume":3,"page":"258"}],"type":"paragraph"},{"text":{"ar":"وأرسل ابنه عبد الله إلى عائشة يستأذنها أن يُدفن مع صاحبيه، فأذنت له."},"reliability":"established","citations":[{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"3700"}],"type":"paragraph"},{"text":{"ar":"وجعل الأمر من بعده شورى في ستة من الصحابة: عثمان وعلي وطلحة والزبير وسعد بن أبي وقاص وعبد الرحمن بن عوف، وذكر أن النبي ﷺ توفي وهو عنهم راضٍ."},"reliability":"established","citations":[{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"3700"}],"type":"paragraph"},{"text":{"ar":"ودُفن إلى جانب النبي ﷺ وأبي بكر."},"reliability":"established","citations":[{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"3700"}],"type":"paragraph"},{"text":{"ar":"وأمر ابنه عبد الله أن يحسب ما عليه من الدين، فلما وجده كثيرًا أمره أن يقضيه من مال آل عمر، فإن لم يفِ فمن بني عدي، ثم من قريش."},"reliability":"established","citations":[{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"3700"}],"type":"paragraph"},{"text":{"ar":"ودخل عليه شاب يثني عليه بصحبته للنبي ﷺ وسابقته وعدله، فقال عمر إنه يودّ لو خرج من ذلك كفافًا، لا له ولا عليه."},"reliability":"established","citations":[{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"3700"}],"type":"paragraph"},{"text":{"ar":"وأمر صهيبًا أن يصلي بالناس ثلاثًا، ويخلو أهل الشورى حتى يجتمعوا على رجل، كما يرويه ابن سعد؛ ثم شاور عبد الرحمن بن عوف الناس تلك الليالي، فبايعوا عثمان بن عفان."},"reliability":"reported","citations":[{"sourceId":"tabaqat-ibn-sad","locatorStatus":"complete","volume":3,"page":"259"},{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"7207"},{"sourceId":"tabaqat-ibn-sad","locatorStatus":"complete","volume":3,"page":"260"}],"type":"paragraph"},{"text":{"ar":"وكانت خلافته عشر سنين وأشهرًا، ومات وهو ابن ثلاث وستين سنة على الصحيح."},"reliability":"established","citations":[{"sourceId":"muslim","locatorStatus":"complete","hadithNumber":"2348"},{"sourceId":"tarikh-al-tabari","locatorStatus":"complete","volume":4,"page":"193"}],"type":"paragraph"}]},{"id":"umar.lessons","kind":"lessons","title":{"ar":"دروس وعبر"},"blocks":[{"text":{"ar":"تُظهر سيرته أن القوة في الحق إذا اقترنت بالعدل ومحاسبة النفس كانت سببًا لصلاح الناس."},"type":"lesson"},{"text":{"ar":"رأى عمر أن الولاية أمانة يُسأل عنها، فحاسب نفسه قبل ولاته؛ والسلطة عنده تكليف قبل أن تكون تشريفًا."},"type":"lesson"},{"text":{"ar":"وفي رجوعه عن الشام بعد المشورة، ثم قبوله الحديث حين بلغه، بيان أن الحزم لا يمنع الرجوع إلى العلم."},"type":"lesson"},{"text":{"ar":"وفي تحوّله من أشدّ الناس على المسلمين إلى من أعزّ الله به الإسلام دليل على أن القلوب بيد الله، وأن الماضي لا يحجب المستقبل."},"type":"lesson"},{"text":{"ar":"ومن سيرته أن الحاكم العادل يحرس حقوق من خالفه في الدين كما يحرس حقوق أهله، وأن العهود مع الناس دين يُسأل عنه."},"type":"lesson"},{"text":{"ar":"ومن سيرته أن المحاسبة لا تعني الاتهام؛ فقد كان يتحرّى قبل أن يحكم، ويعزل أحيانًا اتقاءً للفتنة مع حفظ مكانة من عزله، كما فعل مع سعد وخالد."},"type":"lesson"},{"text":{"ar":"وفي إبقائه الأرض المفتوحة موردًا عامًّا نظر إلى حق الأجيال القادمة، لا إلى مصلحة الحاضرين وحدهم."},"type":"lesson"}]}],"storyIds":["the-house-of-said-ibn-zayd","day-of-badr","the-archers-of-uhud","the-trench","treaty-of-hudaybiyah","the-conquest-of-makkah","hunayn-and-the-ansar","army-of-hardship","the-farewell-pilgrimage","the-day-of-saqifah","jam-al-quran","the-plague-at-sargh","the-prayers-of-sad"],"timeline":[{"id":"umar.t.birth","era":"preIslam","date":{"precision":"approx","era":"beforeHijra","hijriYear":40,"gregorianYear":584},"title":{"ar":"مولده بمكة"},"reliability":"reported","citations":[{"sourceId":"tabaqat-ibn-sad","locatorStatus":"complete","volume":3,"page":"204"},{"sourceId":"istiab","locatorStatus":"complete","volume":3,"page":"1145"}],"sectionId":"umar.early-life"},{"id":"umar.t.islam","era":"makkan","date":{"precision":"approx","era":"beforeHijra","hijriYear":8},"title":{"ar":"إسلامه بمكة"},"reliability":"reported","citations":[{"sourceId":"isabah","locatorStatus":"complete","volume":4,"page":"588"},{"sourceId":"tabaqat-ibn-sad","locatorStatus":"complete","volume":3,"page":"204"}],"sectionId":"umar.conversion"},{"id":"umar.t.hijrah","era":"madinan","date":{"precision":"year","era":"afterHijra","hijriYear":1,"gregorianYear":622},"title":{"ar":"هجرته إلى المدينة"},"reliability":"established","citations":[{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"3925"}],"eventId":"hijrah","sectionId":"umar.with-prophet"},{"id":"umar.t.badr","era":"madinan","date":{"precision":"month","era":"afterHijra","hijriYear":2,"hijriMonth":9,"gregorianYear":624},"title":{"ar":"شهوده غزوة ب