{"schemaVersion":2,"id":"hafsa","gender":"female","name":{"ar":"حفصة بنت عمر"},"fullName":{"ar":"حفصة بنت عمر بن الخطاب العدوية"},"summary":{"ar":"أم المؤمنين، بنت عمر بن الخطاب، تزوّجها النبي ﷺ سنة ثلاث، وعندها حُفظت صحف القرآن التي جُمعت في عهد أبي بكر."},"review":{"status":"preliminaryReview","editorialFlags":[],"coverage":"sample"},"references":["siyar"],"order":19,"lineage":{"ar":"من بني عدي بن كعب، من قريش"},"titles":[{"ar":"أم المؤمنين"}],"aliases":["حفصة"],"death":{"date":{"precision":"approx","era":"afterHijra","hijriYear":41,"gregorianYear":661},"reliability":"reported","citations":[{"sourceId":"siyar","locatorStatus":"complete","volume":2,"page":"229"}]},"deathPlace":{"ar":"المدينة"},"atAGlance":[],"memberships":[{"categoryId":"ummahat-al-muminin","citations":[{"sourceId":"quran","locatorStatus":"complete","quranRef":{"surah":33,"ayahFrom":6}},{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"4005"}]},{"categoryId":"muhajirun","citations":[{"sourceId":"istiab","locatorStatus":"complete","volume":4,"page":"1811"},{"sourceId":"al-bidaya","locatorStatus":"complete","volume":11,"page":"172"}]}],"relations":[{"type":"spouse","person":{"displayName":{"ar":"محمد رسول الله"},"personId":"muhammad"},"citations":[{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"4005"}]},{"type":"father","person":{"displayName":{"ar":"عمر بن الخطاب"},"companionId":"umar"},"citations":[{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"4005"}]}],"sections":[{"id":"hafsa.marriage","kind":"withProphet","title":{"ar":"زواجها"},"blocks":[{"text":{"ar":"كانت حفصة تحت خنيس بن حذافة السهمي، وهو من أهل بدر، فتوفي بالمدينة، فعرضها أبوها عمر على عثمان فاعتذر، ثم على أبي بكر فسكت، ثم خطبها النبي ﷺ فزوّجه إياها."},"reliability":"established","citations":[{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"4005"}],"type":"paragraph"},{"text":{"ar":"ثم لقي أبو بكر عمر فأخبره أنه لم يمنعه أن يجيبه إلا أنه علم أن النبي ﷺ قد ذكرها، فلم يكن ليفشي سرّه، ولو تركها لقبلها."},"reliability":"established","citations":[{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"4005"}],"type":"paragraph"},{"text":{"ar":"وكان ذلك في السنة الثالثة من الهجرة على ما يذكر الذهبي، ويُروى أن مولدها كان قبل المبعث بخمس سنين، وأنها أسنّ من أخيها عبد الله بن عمر بست سنين."},"reliability":"reported","citations":[{"sourceId":"siyar","locatorStatus":"complete","volume":2,"page":"227"},{"sourceId":"siyar","locatorStatus":"complete","volume":2,"page":"227"}],"type":"paragraph"},{"text":{"ar":"ويروي الذهبي بإسناد يصفه بالصالح أن النبي ﷺ طلّقها تطليقة ثم راجعها، وأن جبريل وصفها بأنها صوّامة قوّامة، وأنها زوجته في الجنة."},"reliability":"reported","citations":[{"sourceId":"siyar","locatorStatus":"complete","volume":2,"page":"228"}],"type":"paragraph"},{"text":{"ar":"وروت عن النبي ﷺ أحاديث، وروى عنها أخوها عبد الله بن عمر وغيره."},"reliability":"reported","citations":[{"sourceId":"siyar","locatorStatus":"complete","volume":2,"page":"227"}],"type":"paragraph"}]},{"id":"hafsa.the-suhuf","kind":"contributions","title":{"ar":"الصحف عندها"},"blocks":[{"text":{"ar":"لما جُمع القرآن في صحف في خلافة أبي بكر بقيت الصحف عنده حتى توفي، ثم عند عمر حتى توفي، ثم عند حفصة."},"reliability":"established","citations":[{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"4986"}],"type":"paragraph"},{"text":{"ar":"فلما أراد عثمان أن ينسخ المصاحف أرسل إليها أن ترسل بالصحف، فبعثت بها، ثم ردّها إليها بعد النسخ."},"reliability":"established","citations":[{"sourceId":"bukhari","locatorStatus":"complete","hadithNumber":"4987"}],"type":"paragraph"},{"text":{"ar":"وجعلها أبوها عمر ناظرة على صدقته التي وقفها، تليها ما عاشت، ثم يليها ذو الرأي من أهلها، كما في سنن أبي داود."},"reliability":"reported","citations":[{"sourceId":"abu-dawud","locatorStatus":"complete","hadithNumber":"2879"}],"type":"paragraph"}]},{"id":"hafsa.death","kind":"death","title":{"ar":"وفاتها"},"blocks":[{"text":{"ar":"يذكر الذهبي أنها توفيت سنة إحدى وأربعين، وفي ذلك قول آخر."},"reliability":"reported","citations":[{"sourceId":"siyar","locatorStatus":"complete","volume":2,"page":"229"}],"type":"paragraph"}]},{"id":"hafsa.lessons","kind":"lessons","title":{"ar":"دروس من سيرتها"},"blocks":[{"text":{"ar":"أن حفظ الأمانة من أعظم القربات، فقد ائتُمنت حفصة على أصل المصحف فأدّته."},"type":"lesson"},{"text":{"ar":"وأن كتمان السرّ من خلق الصالحين، كما صنع أبو بكر."},"type":"lesson"}]}],"storyIds":["jam-al-quran"],"timeline":[{"id":"hafsa.marriage","era":"madinan","date":{"precision":"year","era":"afterHijra","hijriYear":3,"gregorianYear":625},"title":{"ar":"زواجها من النبي ﷺ"},"reliability":"reported","citations":[{"sourceId":"siyar","locatorStatus":"complete","volume":2,"page":"227"}],"sectionId":"hafsa.marriage"},{"id":"hafsa.death","era":"afterProphet","date":{"precision":"approx","era":"afterHijra","hijriYear":41,"gregorianYear":661},"title":{"ar":"وفاتها"},"reliability":"reported","citations":[{"sourceId":"siyar","locatorStatus":"complete","volume":2,"page":"229"}],"sectionId":"hafsa.death"}]}