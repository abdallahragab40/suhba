  },
  "takeaway": {
    "ar": "مكة هي موضع البيت، وموطن قريش، ومولد النبي ﷺ ومبعثه، وإليها عاد فاتحًا."
  },
  "notes": [
    {
      "ar": "المشهد المرسوم تكوين توضيحي غير تصويري، وليس صورة للمكان في القرن السابع."
    }
  ],
