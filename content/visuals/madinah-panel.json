    "ar": "المدينة: دار الهجرة"
  },
  "takeaway": {
    "ar": "المدينة هي التي آوت النبي ﷺ وأصحابه، وفيها قام المسجد والمجتمع الأول، وفيها توفي ﷺ."
  },
  "notes": [
    {
      "ar": "المشهد المرسوم تكوين توضيحي غير تصويري، والمسجد النبوي اليوم بناء حديث موسّع."
    }
  ],
