  "title": {
    "ar": "الهجرة إلى الحبشة"
  },
  "takeaway": {
    "ar": "عبر المهاجرون الأوائل البحر الأحمر من الحجاز إلى مملكة النجاشي، بعيدًا عن أذى قريش."
  },
  "notes": [
    {
      "ar": "الخط يصل بين مكة ومنطقة المملكة، ولا يرسم طريق المهاجرين الفعلي ولا ميناء خروجهم."
    },
    {
      "ar": "موضع الحبشة تقريبي يشير إلى منطقة المملكة لا إلى مدينة بعينها."
    }
  ],
