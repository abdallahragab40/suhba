        }
      ],
      "placeId": "ghar-thawr"
    },
    {
      "title": {
        "ar": "قباء"
      },
      "text": {
        "ar": "نزل النبي ﷺ في بني عمرو بن عوف وأسّس مسجد قباء."
      },
      "reliability": "established",
