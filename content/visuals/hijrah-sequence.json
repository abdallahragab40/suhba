    },
    {
      "title": {
        "ar": "مكر قريش"
      },
      "text": {
        "ar": "اجتمعت قريش في دار الندوة وأجمعت على قتل النبي ﷺ."
      },
      "reliability": "reported",
      "citations": [
        {
