  "title": {
    "ar": "مراحل السيرة على مقياس الزمن"
  },
  "takeaway": {
    "ar": "عاش النبي ﷺ نحو أربعين سنة قبل البعثة، ثم ثلاث عشرة سنة نبيًّا في مكة، ثم عشر سنين في المدينة."
  },
  "notes": [
    {
      "ar": "أطوال الأشرطة متناسبة مع عدد السنين التقريبي، والسنوات الميلادية موافقة تقريبية."
    },
    {
      "ar": "عمره ﷺ عند الوفاة ثلاث وستون سنة على الصحيح، وفي ذلك روايات أخرى."
    }
  ],
