            "noEmbellishment": {
              "type": "boolean"
            },
            "reliabilityCorrect": {
              "type": "boolean"
            },
            "honorificsCorrect": {
              "type": "boolean"
            },
            "fitnaSignOff": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "sourcesMatch",
            "gradingsCorrect",
            "noEmbellishment",
            "reliabilityCorrect",
            "honorificsCorrect"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "reviewerId",
        "approvedAt",
        "contentHash",
        "checklist"
      ],
      "description": "content/reviews/<kind>.<id>.json"
    }
  }
