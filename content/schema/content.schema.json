            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "qualification": {
                "type": "string",
                "minLength": 1
              },
              "addedAt": {
                "type": "string",
                "format": "date"
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "qualification",
              "addedAt"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "reviewers"
      ],
      "description": "content/reviewers.json — qualified reviewers only."
    },
    "approvalFile": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "companion",
            "story",
            "event",
            "category",
            "source",
            "person"
          ]
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "reviewerId": {
          "$ref": "#/$defs/id"
        },
        "approvedAt": {
          "type": "string",
          "format": "date"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "checklist": {
          "type": "object",
          "properties": {
            "sourcesMatch": {
              "type": "boolean"
