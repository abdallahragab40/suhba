  "sections": [
    {
      "id": "fatimah.life",
      "kind": "earlyLife",
      "title": {
        "ar": "نشأتها وزواجها"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "وُلدت فاطمة قبل المبعث بقليل، ونشأت في بيت النبوة بمكة، ثم هاجرت إلى المدينة."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "119"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وتزوّجها علي بن أبي طالب في السنة الثانية بعد بدر، فولدت له الحسن والحسين، وأم كلثوم وزينب، على ما يذكر الذهبي."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "119"
            },
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "119"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وكانت يوم أحد تغسل الدم عن وجه أبيها لما جُرح، وعلي يأتي بالماء، فلما رأت الدم لا يرقأ أحرقت حصيرًا وألصقت رماده بالجرح فاستمسك الدم."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "2911"
            },
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3037"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وشكت يومًا ما تلقى من الرحى في يدها، فجاءت تسأل أباها خادمًا، فدلّها هي وعليًّا على ما هو خير لهما من خادم: أن يسبّحا الله عند المنام ثلاثًا وثلاثين، ويحمداه ثلاثًا وثلاثين، ويكبّراه أربعًا وثلاثين."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3113"
            },
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "5361"
            }
          ]
        }
      ]
    },
    {
      "id": "fatimah.virtues",
      "kind": "virtues",
      "title": {
        "ar": "من فضائلها"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "أخبر النبي ﷺ أن فاطمة بضعة منه، فمن أغضبها أغضبه."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3714"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وكانت تشبه أباها في مشيتها، فإذا أقبلت رحّب بها، وأسرّ إليها في مرضه الأخير أنه مقبوض فبكت، ثم أسرّ إليها أنها أول أهله لحوقًا به، وأنها سيدة نساء أهل الجنة أو نساء المؤمنين، فضحكت، وكتمت ذلك حتى توفي، كما تروي عائشة."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3623"
            },
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3624"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وتروي عائشة أن النبي ﷺ أدخل عليًّا وفاطمة والحسن والحسين تحت مرط له، ثم تلا قوله تعالى: إنما يريد الله ليذهب عنكم الرجس أهل البيت ويطهركم تطهيرًا."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "muslim",
              "locatorStatus": "complete",
              "hadithNumber": "2424"
            },
            {
              "sourceId": "quran",
              "locatorStatus": "complete",
              "quranRef": {
                "surah": 33,
                "ayahFrom": 33
              }
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ويذكر الذهبي أنها حزنت عليه حزنًا شديدًا، وأنها قالت لأنس بعد دفنه كيف طابت أنفسهم أن يحثوا التراب على رسول الله ﷺ."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "120"
            }
          ]
        }
      ]
    },
    {
      "id": "fatimah.death",
      "kind": "death",
      "title": {
        "ar": "وفاتها"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "عاشت فاطمة بعد النبي ﷺ ستة أشهر، ثم توفيت، فدفنها علي ليلًا وصلّى عليها، كما تروي عائشة في صحيح البخاري، فكانت أول أهله لحوقًا به كما أخبرها."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "4240"
            }
          ]
        }
      ]
    },
    {
      "id": "fatimah.lessons",
      "kind": "lessons",
      "title": {
        "ar": "دروس من سيرتها"
      },
      "blocks": [
        {
          "type": "lesson",
          "text": {
            "ar": "أن بيت النبوة قام على الصبر والقناعة، فدلّ النبي ﷺ ابنته على الذكر بدل الخادم."
          }
        },
        {
          "type": "lesson",
          "text": {
            "ar": "وأن برّ الوالدين والقرب منهما من أعظم ما تُحفظ به المحبة."
          }
        }
      ]
    }
  ],
