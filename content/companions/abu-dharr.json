  "sections": [
    {
      "id": "abu-dharr.islam",
      "kind": "conversion",
      "title": {
        "ar": "إسلامه"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "بلغ أبا ذر وهو في قومه غفار خبر رجل بمكة يزعم أنه نبي، فبعث أخاه يتعرّف خبره، ثم قدم بنفسه، فلزم المسجد لا يسأل أحدًا خوفًا من قريش، حتى رآه علي بن أبي طالب فأضافه، ثم أدخله على النبي ﷺ فأسلم مكانه، كما يروي ابن عباس في صحيح البخاري."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3522"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وأمره النبي ﷺ أن يكتم أمره ويرجع إلى قومه، فأقسم أن يصرخ بها بين ظهراني قريش، فخرج إلى المسجد فنادى بالشهادة، فقاموا إليه فضربوه حتى أوجعوه، فأكبّ عليه العباس يذكّرهم أن طريق تجارتهم إلى الشام على غفار، فتركوه."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3522"
            },
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3861"
            }
          ]
        }
      ]
    },
    {
      "id": "abu-dharr.with-the-prophet",
      "kind": "withProphet",
      "title": {
        "ar": "مع النبي ﷺ"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "سأل أبو ذر النبي ﷺ أن يستعمله على عمل، فضرب بيده على منكبه وأخبره أنه ضعيف، وأنها أمانة، وأنها يوم القيامة خزي وندامة إلا من أخذها بحقها وأدّى الذي عليه فيها."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "muslim",
              "locatorStatus": "complete",
              "hadithNumber": "1825"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وعيّر أبو ذر رجلًا بأمه، فقال له النبي ﷺ: إنك امرؤ فيك جاهلية، وأمره أن يطعم من تحت يده مما يأكل، ويلبسه مما يلبس، فكان أبو ذر بعد ذلك يُرى وعليه حلّة وعلى غلامه مثلها."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "30"
            }
          ]
        }
      ]
    },
    {
      "id": "abu-dharr.rabadhah",
      "kind": "contributions",
      "title": {
        "ar": "نزوله الربذة"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "ويروي زيد بن وهب أنه مرّ بأبي ذر في الربذة فسأله عمّا أنزله بها، فذكر أنه كان بالشام فاختلف هو ومعاوية في تأويل آية الكنز، وأنه يرى أنها نزلت في المسلمين وأهل الكتاب، فكتب معاوية إلى عثمان، فاستقدمه عثمان المدينة فكثر عليه الناس، فخيّره عثمان أن يتنحّى فيكون قريبًا، فنزل الربذة."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "1406"
            },
            {
              "sourceId": "quran",
              "locatorStatus": "complete",
              "quranRef": {
                "surah": 9,
                "ayahFrom": 34
              }
            }
          ]
        }
      ]
    },
    {
      "id": "abu-dharr.death",
      "kind": "death",
      "title": {
        "ar": "وفاته"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "ويذكر الذهبي أن أبا ذر أوصى عند موته امرأته وغلامه أن يغسّلاه ويكفّناه ويضعاه على الطريق، فأول ركب يمرّون بهم يُخبَرون أنه أبو ذر، فكان ذلك، وتوفي بالربذة سنة اثنتين وثلاثين."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "57"
            },
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "74"
            }
          ]
        }
      ]
    },
    {
      "id": "abu-dharr.lessons",
      "kind": "lessons",
      "title": {
        "ar": "دروس من سيرته"
      },
      "blocks": [
        {
          "type": "lesson",
          "text": {
            "ar": "أن الصدق في طلب الحق والجرأة في إعلانه من صفات السابقين."
          }
        },
        {
          "type": "lesson",
          "text": {
            "ar": "وأن الولاية أمانة، وأن معرفة الإنسان بطاقته من الحكمة."
          }
        },
        {
          "type": "lesson",
          "text": {
            "ar": "وأن المساواة بين الناس في الكرامة أصل في الإسلام، يعالج بقايا الجاهلية في النفوس."
          }
        }
      ]
    }
  ],
