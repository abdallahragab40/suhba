  "sections": [
    {
      "id": "hamzah.islam",
      "kind": "conversion",
      "title": {
        "ar": "إسلامه"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "كان حمزة عمّ النبي ﷺ، وأخاه من الرضاعة، ولذلك ذكر النبي ﷺ أن ابنة حمزة لا تحلّ له لأنها ابنة أخيه من الرضاعة."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "5100"
            },
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 1,
              "page": "172"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ويروي ابن إسحاق أن أبا جهل آذى النبي ﷺ ونال منه عند الصفا، فلما رجع حمزة من صيده وأُخبر بذلك غضب، فأتى أبا جهل في مجلس قريش فضربه بقوسه، وأعلن إسلامه."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "sirat-ibn-hisham",
              "locatorStatus": "complete",
              "volume": 1,
              "page": "291"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وكان حمزة معروفًا في قومه بالشدة والفروسية، ويلقّبه أهل التراجم بأسد الله، ويُكنى أبا عمارة."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 1,
              "page": "172"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ويذكر ابن إسحاق أن قريشًا لما أسلم حمزة عرفت أن رسول الله ﷺ قد امتنع، وأن حمزة سيمنعه، فكفّوا عن بعض ما كانوا ينالون منه."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 1,
              "page": "172"
            }
          ]
        }
      ]
    },
    {
      "id": "hamzah.badr",
      "kind": "withProphet",
      "title": {
        "ar": "مع النبي ﷺ في بدر"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "هاجر حمزة إلى المدينة، وكان يوم بدر أحد الثلاثة الذين برزوا لعتبة وشيبة ابني ربيعة والوليد بن عتبة، هو وعلي بن أبي طالب وعبيدة بن الحارث، وفيهم نزل قوله تعالى: ﴿هذان خصمان اختصموا في ربهم﴾، كما كان أبو ذر يقسم."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3969"
            },
            {
              "sourceId": "quran",
              "locatorStatus": "complete",
              "quranRef": {
                "surah": 22,
                "ayahFrom": 19
              }
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ويذكر ابن إسحاق أن النبي ﷺ بعث حمزة في سرية إلى سيف البحر من ناحية العيص، فلقي أبا جهل ومن معه، وحجز بين الفريقين مجدي بن عمرو الجهني، فلم يكن بينهم قتال. ويذكر اختلافًا في أول راية عُقدت: أكانت لعبيدة بن الحارث أم لحمزة."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "sirat-ibn-hisham",
              "locatorStatus": "complete",
              "volume": 1,
              "page": "595"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وقتل حمزة يوم بدر طعيمة بن عدي، فكان ذلك سبب ما جرى له بعدُ يوم أحد، إذ وعد جبير بن مطعم عبده وحشيًّا بالعتق إن قتل حمزة بعمّه، كما يحدّث وحشي نفسه في صحيح البخاري."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "4072"
            }
          ]
        }
      ]
    },
    {
      "id": "hamzah.uhud",
      "kind": "death",
      "title": {
        "ar": "استشهاده يوم أحد"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "خرج حمزة يوم أحد يقاتل، فكمن له وحشي خلف صخرة، ثم رماه بحربته فقتله. وأسلم وحشي بعد ذلك، فسأله النبي ﷺ عن قتله، ثم طلب منه أن يغيّب وجهه عنه، فخرج وحشي بعدُ إلى قتال مسيلمة يرجو أن يكافئ بقتله ما كان من قتل حمزة."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "4072"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ويروي أنس بن مالك أن النبي ﷺ وقف عليه وقد مُثّل به، فاشتد ذلك عليه، وأنه كُفّن في نمرة قصيرة إذا غُطّي بها رأسه بدت رجلاه، وهي رواية يذكرها الذهبي من طريق أسامة بن زيد الليثي."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 1,
              "page": "177"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وكان عبد الرحمن بن عوف يذكره بعد سنين وهو صائم قد قُدّم إليه طعامه، فيذكر أن حمزة قُتل وهو خير منه، ويخشى أن تكون قد عُجّلت لهم طيباتهم، ثم يبكي حتى يترك الطعام."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "1275"
            },
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "1274"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ويروي ابن عمر أن النبي ﷺ لما رجع من أحد سمع نساء الأنصار يبكين قتلاهن، فذكر أن حمزة لا بواكي له، فجئن فبكين عليه، وهي رواية في المسند يذكرها الذهبي."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 1,
              "page": "172"
            }
          ]
        }
      ]
    },
    {
      "id": "hamzah.lessons",
      "kind": "lessons",
      "title": {
        "ar": "دروس من سيرته"
      },
      "blocks": [
        {
          "type": "lesson",
          "text": {
            "ar": "أن الغضب للحق إذا اقترن بالإيمان صار قوة للدعوة، فقد كان إسلام حمزة عزًّا للمستضعفين بمكة."
          }
        },
        {
          "type": "lesson",
          "text": {
            "ar": "وأن المسلم يحفظ للشهداء سابقتهم، فقد بكى عبد الرحمن بن عوف وهو في سعة من العيش حين تذكّر حمزة ومصعبًا وما كُفّنا فيه."
          }
        },
        {
          "type": "lesson",
          "text": {
            "ar": "وأن التوبة تجبّ ما قبلها، فقد قبل النبي ﷺ إسلام قاتل عمّه، وإن طلب ألّا يرى وجهه."
          }
        }
      ]
    }
  ],
