  "sections": [
    {
      "id": "sawdah.early",
      "kind": "earlyLife",
      "title": {
        "ar": "إسلامها وهجرتها"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "كانت سودة بنت زمعة القرشية العامرية قبل النبي ﷺ عند السكران بن عمرو، أخي سهيل بن عمرو، ويذكر ابن سعد أنها أسلمت هي وزوجها، وهاجرا إلى الحبشة."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "265"
            },
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "267"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ويروي بكير بن الأشج أن السكران قدم بها من الحبشة فتوفي عنها، فخطبها النبي ﷺ، فقالت: أمري إليك، فأمرها أن تأمر رجلًا من قومها يزوّجها، فزوّجها حاطب بن عمرو العامري، وهو مهاجري بدري."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "267"
            }
          ]
        }
      ]
    },
    {
      "id": "sawdah.marriage",
      "kind": "withProphet",
      "title": {
        "ar": "زواجها من النبي ﷺ"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "وهي أول من تزوج بها النبي ﷺ بعد خديجة، وانفردت به نحوًا من ثلاث سنين أو أكثر حتى دخل بعائشة، على ما يذكر الذهبي."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "265"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ويروي الواقدي أن النبي ﷺ تزوجها في رمضان سنة عشر من النبوة، ويروي عن عائشة أن النبي ﷺ لما قدم المدينة بعث زيد بن حارثة وأبا رافع، فقدما بأهله، وفيهم سودة بنت زمعة."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "267"
            },
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "269"
            }
          ]
        }
      ]
    },
    {
      "id": "sawdah.character",
      "kind": "character",
      "title": {
        "ar": "مكانتها وخلقها"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "قالت عائشة: ما رأيت امرأة أحب إليّ أن أكون في مسلاخها من سودة بنت زمعة، من امرأة فيها حدّة. فلما كبرت جعلت يومها من رسول الله ﷺ لعائشة، فكان يقسم لعائشة يومين: يومها ويوم سودة."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "muslim",
              "locatorStatus": "complete",
              "hadithNumber": "1463"
            },
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "5212"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وكانت امرأة ثقيلة ثبطة، فاستأذنت النبي ﷺ ليلة المزدلفة أن تدفع قبله وقبل حطمة الناس، فأذن لها، وكانت عائشة تتمنى بعد ذلك لو استأذنته كما استأذنته سودة."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "1680"
            },
            {
              "sourceId": "muslim",
              "locatorStatus": "complete",
              "hadithNumber": "1290"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ويروي ابن سيرين أن عمر بن الخطاب بعث إليها بغرارة من دراهم، فلما علمت ما فيها فرّقتها."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "269"
            }
          ]
        }
      ]
    },
    {
      "id": "sawdah.death",
      "kind": "death",
      "title": {
        "ar": "وفاتها"
      },
      "blocks": [
        {
          "type": "disputeNote",
          "text": {
            "ar": "اختُلف في سنة وفاتها."
          },
          "opinions": [
            {
              "text": {
                "ar": "توفيت بالمدينة في آخر خلافة عمر، وهو ما يذكره الذهبي، ويرويه سعيد بن أبي هلال."
              },
              "citations": [
                {
                  "sourceId": "siyar",
                  "locatorStatus": "complete",
                  "volume": 2,
                  "page": "266"
                },
                {
                  "sourceId": "siyar",
                  "locatorStatus": "complete",
                  "volume": 2,
                  "page": "267"
                }
              ]
            },
            {
              "text": {
                "ar": "توفيت بالمدينة في شوال سنة أربع وخمسين، فيما يرويه الواقدي، وقال: هذا الثبت عندنا."
              },
              "citations": [
                {
                  "sourceId": "siyar",
                  "locatorStatus": "complete",
                  "volume": 2,
                  "page": "267"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "sawdah.lessons",
      "kind": "lessons",
      "title": {
        "ar": "دروس من سيرتها"
      },
      "blocks": [
        {
          "type": "lesson",
          "text": {
            "ar": "أن الإيثار في الحقوق الخاصة طلبًا لما يحبه النبي ﷺ من كريم الخلق."
          }
        },
        {
          "type": "lesson",
          "text": {
            "ar": "وأن الرخصة لأهل الأعذار من سعة الشريعة، كما أذن النبي ﷺ لسودة أن تدفع من المزدلفة قبل الناس."
          }
        }
      ]
    }
  ],
