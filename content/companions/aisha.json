  "sections": [
    {
      "id": "aisha.early-life",
      "kind": "earlyLife",
      "title": {
        "ar": "نشأتها في بيت أبي بكر"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "هي عائشة بنت أبي بكر الصديق عبد الله بن أبي قحافة عثمان بن عامر، من بني تيم بن مرة من قريش، وأمها أم رومان، من بني كنانة."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "135"
            },
            {
              "sourceId": "istiab",
              "locatorStatus": "complete",
              "volume": 4,
              "page": "1881"
            },
            {
              "sourceId": "tabaqat-ibn-sad",
              "locatorStatus": "complete",
              "volume": 8,
              "page": "46"
            },
            {
              "sourceId": "al-bidaya",
              "locatorStatus": "complete",
              "volume": 11,
              "page": "336"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ويذكر الذهبي أنها ممن وُلد في الإسلام."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "139"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وكانت تقول إنها لم تعقل أبويها قط إلا وهما يدينان الدين، وإنه لم يكن يمرّ عليهم يوم إلا يأتيهم فيه رسول الله ﷺ طرفي النهار، بكرة وعشية."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3905"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وشهدت في بيت أبيها يوم جاءه النبي ﷺ في نحر الظهيرة يخبره بالإذن في الهجرة، فجهّزوهما أحثّ الجهاز، وربطت أختها أسماء جراب زادهما بقطعة من نطاقها، وهي التي روت ذلك."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3905"
            }
          ]
        }
      ]
    },
    {
      "id": "aisha.marriage",
      "kind": "withProphet",
      "title": {
        "ar": "زواجها وهجرتها"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "تزوّجها النبي ﷺ بمكة بعد وفاة خديجة، ثم بنى بها في المدينة بعد الهجرة، ولم يتزوّج بكرًا غيرها."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3894"
            },
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "4753"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وأخبرها النبي ﷺ أنه أُريها في المنام مرتين، في سرقة من حرير، ويقال له: هذه امرأتك، فقال: إن يك هذا من عند الله يُمضه."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3895"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ويذكر ابن سعد والذهبي أن أبا بكر كان قد ذكرها للمطعم بن عدي لابنه جبير، فلم يزوّجها النبي ﷺ حتى خلص من ذلك الوعد."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "tabaqat-ibn-sad",
              "locatorStatus": "complete",
              "volume": 8,
              "page": "46"
            },
            {
              "sourceId": "tabaqat-ibn-sad",
              "locatorStatus": "complete",
              "volume": 8,
              "page": "47"
            },
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "149"
            },
            {
              "sourceId": "istiab",
              "locatorStatus": "complete",
              "volume": 4,
              "page": "1881"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وفي صحيح البخاري أن النبي ﷺ تزوّجها وهي بنت ست سنين، وبنى بها وهي بنت تسع سنين."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3894"
            },
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3896"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وكان عقده عليها وعلى سودة بنت زمعة متقاربًا بعد وفاة خديجة، ثم دخل بسودة بمكة، وتأخّر دخوله بعائشة إلى المدينة، على ما يذكر الذهبي؛ واختُلف أيّ العقدين كان أولًا، كما يذكر ابن عبد البر وابن كثير."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "141"
            },
            {
              "sourceId": "istiab",
              "locatorStatus": "complete",
              "volume": 4,
              "page": "1867"
            },
            {
              "sourceId": "al-bidaya",
              "locatorStatus": "complete",
              "volume": 4,
              "page": "333"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وبقيت بمكة حين هاجر النبي ﷺ وأبوها، ثم خرجت مع أمها وأختها أسماء، يحملهم أخوها عبد الله، حتى قدموا المدينة والمسجد يُبنى، فيما يرويه الواقدي عنها."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "tabaqat-ibn-sad",
              "locatorStatus": "complete",
              "volume": 8,
              "page": "49"
            },
            {
              "sourceId": "tabaqat-ibn-sad",
              "locatorStatus": "complete",
              "volume": 8,
              "page": "50"
            },
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "152"
            },
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "153"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ونزلوا حين قدموا في بني الحارث بن الخزرج، فأصابتها الحمّى حتى تساقط شعرها."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3894"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وكانت تقول إن النبي ﷺ تزوّجها في شوال، وبنى بها في شوال، فأيّ نسائه كان أحظى عنده منها؟"
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "muslim",
              "locatorStatus": "complete",
              "hadithNumber": "1423"
            }
          ]
        },
        {
          "type": "disputeNote",
          "text": {
            "ar": "واختُلف في وقت بنائه ﷺ بها في المدينة."
          },
          "opinions": [
            {
              "text": {
                "ar": "في شوال، على رأس ثمانية أشهر من الهجرة، فيما يرويه الواقدي بسنده عنها."
              },
              "citations": [
                {
                  "sourceId": "tabaqat-ibn-sad",
                  "locatorStatus": "complete",
                  "volume": 8,
                  "page": "46"
                }
              ]
            },
            {
              "text": {
                "ar": "في شوال من السنة الثانية بعد غزوة بدر، على ما يذكر الذهبي وابن كثير، وفي رواية يونس عن الزهري: على رأس ثمانية عشر شهرًا من الهجرة."
              },
              "citations": [
                {
                  "sourceId": "siyar",
                  "locatorStatus": "complete",
                  "volume": 2,
                  "page": "135"
                },
                {
                  "sourceId": "al-bidaya",
                  "locatorStatus": "complete",
                  "volume": 11,
                  "page": "337"
                },
                {
                  "sourceId": "istiab",
                  "locatorStatus": "complete",
                  "volume": 4,
                  "page": "1881"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "aisha.household",
      "kind": "withProphet",
      "title": {
        "ar": "في بيت النبوة"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "وسأله عمرو بن العاص عن أحبّ الناس إليه فذكر عائشة، ثم سأله من الرجال فذكر أباها."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3662"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وكان الناس يتحرّون بهداياهم يومها، فلما كلّمته أم سلمة في ذلك قال: «يا أم سلمة، لا تؤذيني في عائشة، فإنه والله ما نزل عليّ الوحي وأنا في لحاف امرأة منكن غيرها»."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3775"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وأخبرها النبي ﷺ يومًا أن جبريل عليه السلام يقرئها السلام، فردّت عليه السلام."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3768"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وكانت تلعب بالبنات عنده ﷺ مع صواحب لها، فإذا دخل تَوارَين منه، فكان يسرّبهن إليها فيلعبن معها."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "6130"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وكانت تخرج معه في أسفاره، وتروي أنها سابقته مرة فسبقته، ثم سابقها بعد أن حملت اللحم فسبقها، فقال: هذه بتلك، فيما يرويه أبو داود."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "abu-dawud",
              "locatorStatus": "complete",
              "hadithNumber": "2578"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وحدّثت ابن أختها عروة أنهم كانوا يرون ثلاثة أهلّة في شهرين وما أوقدت في أبيات رسول الله ﷺ نار، وأن عيشهم كان الأسودين: التمر والماء."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "6459"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ولما أُمر النبي ﷺ بتخيير أزواجه بدأ بها، وقال إنه ذاكر لها أمرًا فلا عليها ألا تعجل فيه حتى تستأمر أبويها، ثم تلا آيتي التخيير، فقالت:"
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "4785"
            }
          ]
        },
        {
          "type": "reportQuote",
          "textStatus": "complete",
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "4785"
            }
          ],
          "text": {
            "ar": "فَفِي أَىِّ هَذَا أَسْتَأْمِرُ أَبَوَىَّ فَإِنِّي أُرِيدُ اللَّهَ وَرَسُولَهُ وَالدَّارَ الآخِرَةَ"
          },
          "summary": {
            "ar": "جواب عائشة حين خيّرها النبي ﷺ: إنها تريد الله ورسوله والدار الآخرة."
          }
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وأخبر أن فضلها على النساء كفضل الثريد على سائر الطعام."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3769"
            }
          ]
        }
      ]
    },
    {
      "id": "aisha.trial",
      "kind": "virtues",
      "title": {
        "ar": "براءتها وبركتها"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "ابتُليت عائشة بحديث الإفك الذي أشاعه المنافقون، فأنزل الله براءتها في آيات من سورة النور تُتلى إلى يوم القيامة."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "quran",
              "locatorStatus": "complete",
              "quranRef": {
                "surah": 24,
                "ayahFrom": 11
              }
            },
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "4750"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وكان أصل ذلك أنها تأخّرت عن الجيش في إحدى غزواته ﷺ تلتمس عقدًا لها انقطع، فارتحلوا يحسبونها في هودجها، فأدركها صفوان بن المعطّل السلمي، فأناخ لها راحلته وقادها حتى لحق بالجيش، وما كلّمها كلمة."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "4750"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "فتكلّم أهل الإفك، وكان الذي تولّى كبره عبد الله بن أبيّ ابن سلول، ومرضت بعد قدومها شهرًا لا تشعر بشيء، ثم بلغها الخبر، فبكت حتى ظنّ أبواها أن البكاء فالق كبدها."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "4750"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ولبث النبي ﷺ شهرًا لا يوحى إليه في شأنها، فلما كلّمها في ذلك لم تجد مثلًا إلا قول أبي يوسف عليه السلام: فصبر جميل، وكانت تعلم أنها بريئة، وتقول:"
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "4750"
            }
          ]
        },
        {
          "type": "reportQuote",
          "textStatus": "complete",
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "4750"
            }
          ],
          "text": {
            "ar": "وَلَكِنْ وَاللَّهِ مَا كُنْتُ أَظُنُّ أَنَّ اللَّهَ مُنْزِلٌ فِي شَأْنِي وَحْيًا يُتْلَى، وَلَشَأْنِي فِي نَفْسِي كَانَ أَحْقَرَ مِنْ أَنْ يَتَكَلَّمَ اللَّهُ فِيَّ بِأَمْرٍ يُتْلَى"
          },
          "summary": {
            "ar": "قول عائشة: إنها لم تكن تظن أن ينزل في شأنها وحي يُتلى، لأن شأنها في نفسها كان أهون من ذلك."
          }
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "فما قام النبي ﷺ من مجلسه حتى نزل عليه الوحي، فلما سُرّي عنه كانت أول كلمة تكلّم بها:"
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "4750"
            }
          ]
        },
        {
          "type": "hadithQuote",
          "textStatus": "complete",
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "4750",
              "grading": {
                "grade": "sahih",
                "gradedBy": {
                  "ar": "البخاري، بإخراجه في صحيحه"
                }
              }
            }
          ],
          "text": {
            "ar": "يَا عَائِشَةُ، أَمَّا اللَّهُ عَزَّ وَجَلَّ فَقَدْ بَرَّأَكِ"
          },
          "summary": {
            "ar": "بشارة النبي ﷺ عائشة بأن الله أنزل براءتها."
          }
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "فقالت إنها لا تحمد إلا الله، وأنزل الله في براءتها عشر آيات من سورة النور، أولها:"
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "quran",
              "locatorStatus": "complete",
              "quranRef": {
                "surah": 24,
                "ayahFrom": 11,
                "ayahTo": 20
              }
            },
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "4750"
            }
          ]
        },
        {
          "type": "quranQuote",
          "ref": {
            "surah": 24,
            "ayahFrom": 11
          }
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وفي بعض أسفاره ﷺ انقطع عقد لها بالبيداء أو بذات الجيش، فأقام النبي ﷺ والناس على التماسه وليسوا على ماء، فأنزل الله آية التيمم، فقال أسيد بن حضير: ما هي بأول بركتكم يا آل أبي بكر، ثم بعثوا البعير الذي كانت عليه فوجدوا العقد تحته."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "334"
            }
          ]
        }
      ]
    },
    {
      "id": "aisha.the-last-days",
      "kind": "contributions",
      "title": {
        "ar": "وفاة النبي ﷺ في بيتها"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "استأذن النبي ﷺ أزواجه في مرضه الأخير أن يُمرَّض في بيت عائشة، فتوفي في بيتها وفي يومها، ورأسه بين سحرها ونحرها، ودُفن في بيتها."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "4449"
            },
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "1389"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ودخل عليها أخوها عبد الرحمن بن أبي بكر ومعه سواك، فرأت النبي ﷺ ينظر إليه، وعرفت أنه يحب السواك، فأخذته فليّنته له، فاستنّ به وهو مستند إلى صدرها."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "4449"
            },
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "4450"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وجعل ﷺ يُدخل يديه في ماء بين يديه فيمسح بهما وجهه ويقول: لا إله إلا الله، إن للموت سكرات، ثم نصب يده يقول: في الرفيق الأعلى، حتى قُبض ومالت يده."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "4449"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "فكانت تعدّ من نعم الله عليها أنه ﷺ توفي في بيتها وفي يومها وبين سحرها ونحرها، وأن الله جمع بين ريقها وريقه عند موته."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "4449"
            },
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "4451"
            }
          ]
        }
      ]
    },
    {
      "id": "aisha.knowledge",
      "kind": "contributions",
      "title": {
        "ar": "علمها"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "كانت عائشة من أعلم الناس، ويذكر أبو موسى الأشعري أنهم ما أشكل عليهم حديث قط فسألوا عائشة إلا وجدوا عندها منه علمًا، فيما يرويه الترمذي."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "tirmidhi",
              "locatorStatus": "complete",
              "hadithNumber": "3883"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "واختلف رهط من المهاجرين والأنصار في مسألة من مسائل الغسل، فاستأذن عليها أبو موسى الأشعري يسألها، وقال إنه يستحييها، فقالت:"
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "muslim",
              "locatorStatus": "complete",
              "hadithNumber": "349"
            }
          ]
        },
        {
          "type": "reportQuote",
          "textStatus": "complete",
          "reliability": "established",
          "citations": [
            {
              "sourceId": "muslim",
              "locatorStatus": "complete",
              "hadithNumber": "349"
            }
          ],
          "text": {
            "ar": "لاَ تَسْتَحْيِي أَنْ تَسْأَلَنِي عَمَّا كُنْتَ سَائِلاً عَنْهُ أُمَّكَ الَّتِي وَلَدَتْكَ فَإِنَّمَا أَنَا أُمُّكَ"
          },
          "summary": {
            "ar": "قول عائشة لأبي موسى الأشعري حين استحيا أن يسألها."
          }
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ودلّ ابن عباس سعد بن هشام حين سأله عن وتر النبي ﷺ عليها، وقال إنها أعلم أهل الأرض به."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "muslim",
              "locatorStatus": "complete",
              "hadithNumber": "746"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ويقول مسروق إنه رأى مشيخة أصحاب النبي ﷺ الأكابر يسألونها عن الفرائض."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "tabaqat-ibn-sad",
              "locatorStatus": "complete",
              "volume": 8,
              "page": "52"
            },
            {
              "sourceId": "tabaqat-ibn-sad",
              "locatorStatus": "complete",
              "volume": 8,
              "page": "53"
            },
            {
              "sourceId": "istiab",
              "locatorStatus": "complete",
              "volume": 4,
              "page": "1883"
            },
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "182"
            },
            {
              "sourceId": "al-bidaya",
              "locatorStatus": "complete",
              "volume": 11,
              "page": "338"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وحين بلغها قول ابن عمر إن النبي ﷺ اعتمر في رجب قالت: يرحم الله أبا عبد الرحمن، ما اعتمر عمرة إلا وهو شاهده، وما اعتمر في رجب قط."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "1776"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ومن أعظم ما حفظته للأمة وصف حياة النبي ﷺ في بيته؛ فهي التي أخبرت أن خُلقه كان القرآن، وأنه كان يكون في مهنة أهله، فإذا حضرت الصلاة خرج إلى الصلاة."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "muslim",
              "locatorStatus": "complete",
              "hadithNumber": "746"
            },
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "676"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وقال الزهري: لو جُمع علم عائشة إلى علم جميع أزواج النبي ﷺ وعلم جميع النساء لكان علم عائشة أفضل."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "istiab",
              "locatorStatus": "complete",
              "volume": 4,
              "page": "1883"
            },
            {
              "sourceId": "al-bidaya",
              "locatorStatus": "complete",
              "volume": 11,
              "page": "338"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ويذكر الذهبي أن مسندها يبلغ ألفين ومئتين وعشرة أحاديث، اتفق البخاري ومسلم منها على مئة وأربعة وسبعين."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "139"
            }
          ]
        }
      ]
    },
    {
      "id": "aisha.generosity",
      "kind": "character",
      "title": {
        "ar": "كرمها وزهدها"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "وكانت لا تمسك شيئًا مما جاءها من رزق الله إلا تصدّقت به، حتى رأى ابن أختها عبد الله بن الزبير أن يُؤخذ على يديها، كما يروي عروة بن الزبير."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3505"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "فحلفت ألا تكلّمه، حتى استشفع إليها برجال من قريش ومن أخوال النبي ﷺ فكلّمته، ثم جعلت تعتق الرقاب حتى بلغت أربعين، وتقول إنها وددت لو جعلت حين حلفت عملًا تعمله فتفرغ منه."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3505"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وبعث إليها ابن الزبير بمال يبلغ مئة ألف، فجعلت تقسمه في الناس وهي صائمة، فلما أمست قالت لها أم ذرّة: أما استطعتِ أن تشتري لنا بدرهم لحمًا؟ فقالت: لو ذكّرتِني لفعلت."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "tabaqat-ibn-sad",
              "locatorStatus": "complete",
              "volume": 8,
              "page": "53"
            },
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "187"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ويروي عروة أنها تصدّقت بسبعين ألفًا وإنها لترقع جانب درعها."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "187"
            },
            {
              "sourceId": "tabaqat-ibn-sad",
              "locatorStatus": "complete",
              "volume": 8,
              "page": "53"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وكانت تقول: يا ليتني كنت ورقة من هذه الشجرة."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "189"
            },
            {
              "sourceId": "tabaqat-ibn-sad",
              "locatorStatus": "complete",
              "volume": 8,
              "page": "59"
            }
          ]
        }
      ]
    },
    {
      "id": "aisha.death",
      "kind": "death",
      "title": {
        "ar": "وفاتها"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "واستأذن ابن عباس في الدخول عليها قبل موتها، فقالت إنها تخشى أن يثني عليها، ثم أذنت له. فذكر أن النبي ﷺ لم ينكح بكرًا غيرها، وأن عذرها نزل من السماء، وقالت بعد خروجه إنها وددت لو كانت نسيًا منسيًّا."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "4753"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وأوصت ابن أختها عبد الله بن الزبير ألا يدفنها في بيتها مع النبي ﷺ وصاحبيه، وقالت:"
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "1391"
            }
          ]
        },
        {
          "type": "reportQuote",
          "textStatus": "complete",
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "1391"
            }
          ],
          "text": {
            "ar": "لاَ تَدْفِنِّي مَعَهُمْ وَادْفِنِّي مَعَ صَوَاحِبِي بِالْبَقِيعِ، لاَ أُزَكَّى بِهِ أَبَدًا"
          },
          "summary": {
            "ar": "وصية عائشة أن تُدفن مع صواحبها أمهات المؤمنين بالبقيع، لئلا تُزكّى بدفنها في بيتها."
          }
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وتوفيت بالمدينة في شهر رمضان على المشهور، ودُفنت بالبقيع ليلًا بعد الوتر، وصلّى عليها أبو هريرة، وكان يومئذ يخلف مروان بن الحكم على المدينة."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "192"
            },
            {
              "sourceId": "tabaqat-ibn-sad",
              "locatorStatus": "complete",
              "volume": 8,
              "page": "61"
            },
            {
              "sourceId": "istiab",
              "locatorStatus": "complete",
              "volume": 4,
              "page": "1885"
            },
            {
              "sourceId": "al-bidaya",
              "locatorStatus": "complete",
              "volume": 11,
              "page": "342"
            },
            {
              "sourceId": "al-bidaya",
              "locatorStatus": "complete",
              "volume": 11,
              "page": "343"
            }
          ]
        },
        {
          "type": "disputeNote",
          "text": {
            "ar": "واختُلف في سنة وفاتها."
          },
          "opinions": [
            {
              "text": {
                "ar": "سنة سبع وخمسين، وهو قول هشام بن عروة وأحمد بن حنبل، على ما يذكر الذهبي وابن عبد البر."
              },
              "citations": [
                {
                  "sourceId": "siyar",
                  "locatorStatus": "complete",
                  "volume": 2,
                  "page": "192"
                },
                {
                  "sourceId": "istiab",
                  "locatorStatus": "complete",
                  "volume": 4,
                  "page": "1885"
                }
              ]
            },
            {
              "text": {
                "ar": "سنة ثمان وخمسين، وهو قول أبي عبيدة والواقدي، وبه أرّخها ابن كثير."
              },
              "citations": [
                {
                  "sourceId": "siyar",
                  "locatorStatus": "complete",
                  "volume": 2,
                  "page": "192"
                },
                {
                  "sourceId": "tabaqat-ibn-sad",
                  "locatorStatus": "complete",
                  "volume": 8,
                  "page": "62"
                },
                {
                  "sourceId": "al-bidaya",
                  "locatorStatus": "complete",
                  "volume": 11,
                  "page": "342"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "aisha.lessons",
      "kind": "lessons",
      "title": {
        "ar": "دروس من سيرتها"
      },
      "blocks": [
        {
          "type": "lesson",
          "text": {
            "ar": "أن المرأة المسلمة قد تكون مرجعًا في العلم يرجع إليها كبار الصحابة."
          },
          "basedOn": [
            "aisha.knowledge"
          ]
        },
        {
          "type": "lesson",
          "text": {
            "ar": "وأن الله يدافع عن الذين آمنوا، فتكون المحنة سببًا في رفعة صاحبها."
          },
          "basedOn": [
            "aisha.trial"
          ]
        },
        {
          "type": "lesson",
          "text": {
            "ar": "وأن حسن العشرة من هدي النبي ﷺ في بيته، بالملاطفة والمؤانسة ومراعاة حداثة السن."
          },
          "basedOn": [
            "aisha.household"
          ]
        },
        {
          "type": "lesson",
          "text": {
            "ar": "وأن صاحب الفضل يخشى الثناء ولا يغترّ به، كما كانت تتمنى لو كانت نسيًا منسيًّا."
          },
          "basedOn": [
            "aisha.death"
          ]
        },
        {
          "type": "lesson",
          "text": {
            "ar": "وأن السخاء لا ينتظر الغنى، فقد كانت تقسم المال الكثير وهي ترقع ثوبها."
          },
          "basedOn": [
            "aisha.generosity"
          ]
        }
      ]
    }
