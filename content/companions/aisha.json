  "sections": [
    {
      "id": "aisha.marriage",
      "kind": "withProphet",
      "title": {
        "ar": "زواجها ومكانتها"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "تزوّجها النبي ﷺ بمكة بعد وفاة خديجة، ثم بنى بها في المدينة بعد الهجرة، ولم يتزوّج بكرًا غيرها."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3894"
            },
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "4753"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وسأله عمرو بن العاص عن أحبّ الناس إليه فذكر عائشة، ثم سأله من الرجال فذكر أباها."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3662"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وأخبرها النبي ﷺ يومًا أن جبريل يقرئها السلام، فردّت عليه السلام."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3768"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وكانت تخرج معه في أسفاره، وتروي أنها سابقته مرة فسبقته، ثم سابقها بعد أن حملت اللحم فسبقها، فقال: هذه بتلك، فيما يرويه أبو داود."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "abu-dawud",
              "locatorStatus": "complete",
              "hadithNumber": "2578"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وأخبر أن فضلها على النساء كفضل الثريد على سائر الطعام."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3769"
            }
          ]
        }
      ]
    },
    {
      "id": "aisha.trial",
      "kind": "virtues",
      "title": {
        "ar": "براءتها وبركتها"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "ابتُليت عائشة بحديث الإفك الذي أشاعه المنافقون، فأنزل الله براءتها في آيات من سورة النور تُتلى إلى يوم القيامة."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "quran",
              "locatorStatus": "complete",
              "quranRef": {
                "surah": 24,
                "ayahFrom": 11
              }
            },
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "4750"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "واستأذن ابن عباس في الدخول عليها قبل موتها، فقالت إنها تخشى أن يثني عليها، ثم أذنت له. فذكر أن النبي ﷺ لم ينكح بكرًا غيرها، وأن عذرها نزل من السماء، وقالت بعد خروجه إنها وددت لو كانت نسيًا منسيًّا."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "4753"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وكان ضياع عقد لها في سفر سببًا في نزول آية التيمم، فقال أسيد بن حضير إن ذلك ليس بأول بركتهم يا آل أبي بكر."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "334"
            }
          ]
        }
      ]
    },
    {
      "id": "aisha.the-last-days",
      "kind": "contributions",
      "title": {
        "ar": "وفاة النبي ﷺ في بيتها"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "استأذن النبي ﷺ أزواجه في مرضه الأخير أن يُمرَّض في بيت عائشة، فتوفي في بيتها وفي يومها، ورأسه بين سحرها ونحرها، ودُفن في بيتها."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "4449"
            },
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "1389"
            }
          ]
        }
      ]
    },
    {
      "id": "aisha.knowledge",
      "kind": "contributions",
      "title": {
        "ar": "علمها"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "كانت عائشة من أعلم الناس، ويذكر أبو موسى الأشعري أنهم ما أشكل عليهم حديث قط فسألوا عائشة إلا وجدوا عندها منه علمًا، فيما يرويه الترمذي."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "tirmidhi",
              "locatorStatus": "complete",
              "hadithNumber": "3883"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ومن أعظم ما حفظته للأمة وصف حياة النبي ﷺ في بيته؛ فهي التي أخبرت أن خُلقه كان القرآن، وأنه كان يكون في مهنة أهله، فإذا حضرت الصلاة خرج إلى الصلاة."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "muslim",
              "locatorStatus": "complete",
              "hadithNumber": "746"
            },
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "676"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ويذكر الذهبي أن مسندها يبلغ ألفين ومئتين وعشرة أحاديث، اتفق البخاري ومسلم منها على مئة وأربعة وسبعين."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "139"
            }
          ]
        }
      ]
    },
    {
      "id": "aisha.generosity",
      "kind": "character",
      "title": {
        "ar": "كرمها"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "وكانت لا تمسك شيئًا مما جاءها من رزق الله إلا تصدّقت به، حتى رأى ابن أختها عبد الله بن الزبير أن يُؤخذ على يديها، كما يروي عروة بن الزبير."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3505"
            }
          ]
        }
      ]
    },
    {
      "id": "aisha.death",
      "kind": "death",
      "title": {
        "ar": "وفاتها"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "توفيت عائشة بالمدينة، ودُفنت بالبقيع ليلًا، وأرّخ هشام بن عروة وأحمد بن حنبل وفاتها سنة سبع وخمسين، وقال الواقدي وغيره سنة ثمان وخمسين."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "192"
            }
          ]
        }
      ]
    },
    {
      "id": "aisha.lessons",
      "kind": "lessons",
      "title": {
        "ar": "دروس من سيرتها"
      },
      "blocks": [
        {
          "type": "lesson",
          "text": {
            "ar": "أن المرأة المسلمة قد تكون مرجعًا في العلم يرجع إليها كبار الصحابة."
          }
        },
        {
          "type": "lesson",
          "text": {
            "ar": "وأن الله يدافع عن الذين آمنوا، فتكون المحنة سببًا في رفعة صاحبها."
          }
        }
      ]
    }
  ],
