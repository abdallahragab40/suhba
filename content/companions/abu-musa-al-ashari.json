  "sections": [
    {
      "id": "abu-musa-al-ashari.journey",
      "kind": "conversion",
      "title": {
        "ar": "إسلامه وقدومه"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "بلغ أبا موسى مخرج النبي ﷺ وهو باليمن، فخرج مهاجرًا إليه مع أخويه في بضع وخمسين من قومه، فألقتهم سفينتهم إلى النجاشي بالحبشة، فأقاموا مع جعفر بن أبي طالب، ثم قدموا جميعًا على النبي ﷺ حين افتتح خيبر، فأسهم لهم."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3136"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وذكرت أسماء بنت عميس أن النبي ﷺ قال لأهل السفينة: لكم أنتم أهل السفينة هجرتان، فكان أبو موسى وأصحابه يأتونها يسألونها عن هذا الحديث."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "4231"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ويذكر الذهبي أن أول مشاهده خيبر، وأن بعضهم ذكر أنه أسلم بمكة وهاجر إلى الحبشة."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "382"
            }
          ]
        }
      ]
    },
    {
      "id": "abu-musa-al-ashari.with-the-prophet",
      "kind": "withProphet",
      "title": {
        "ar": "مع النبي ﷺ"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "سمع النبي ﷺ قراءته فقال له: يا أبا موسى، لقد أوتيت مزمارًا من مزامير آل داود."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "5048"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وأثنى النبي ﷺ على قومه الأشعريين، فذكر أنهم إذا أرملوا في الغزو أو قلّ طعام عيالهم بالمدينة جمعوا ما عندهم في ثوب واحد ثم اقتسموه بينهم بالسويّة، فهم منه وهو منهم."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "2486"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وبعد حنين بعثه النبي ﷺ مع عمّه أبي عامر في طلب من فرّ إلى أوطاس، فأصيب أبو عامر واستخلفه، فلما رجع وأخبر النبي ﷺ توضّأ ودعا لأبي عامر، ثم دعا لأبي موسى: اللهم اغفر لعبد الله بن قيس ذنبه، وأدخله يوم القيامة مدخلًا كريمًا."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "4323"
            }
          ]
        }
      ]
    },
    {
      "id": "abu-musa-al-ashari.yemen",
      "kind": "contributions",
      "title": {
        "ar": "ولاياته"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "بعثه النبي ﷺ مع معاذ بن جبل إلى اليمن، كلًّا منهما على مخلاف، وأوصاهما: يسّرا ولا تعسّرا، وبشّرا ولا تنفّرا."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "4341"
            },
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3038"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وولي البصرة لعمر وعثمان، وولي الكوفة، ويذكر ابن منده أنه افتتح أصبهان زمن عمر، على ما ينقل الذهبي."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "382"
            },
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "383"
            }
          ]
        }
      ]
    },
    {
      "id": "abu-musa-al-ashari.death",
      "kind": "death",
      "title": {
        "ar": "وفاته"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "يذكر الهيثم بن عدي فيما يرويه ابن سعد أنه مات سنة اثنتين وأربعين، وفي سنته وموضعه أقوال أخرى."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "382"
            }
          ]
        }
      ]
    },
    {
      "id": "abu-musa-al-ashari.lessons",
      "kind": "lessons",
      "title": {
        "ar": "دروس من سيرته"
      },
      "blocks": [
        {
          "type": "lesson",
          "text": {
            "ar": "أن تحسين الصوت بالقرآن مما يحبه النبي ﷺ ويثني عليه."
          }
        },
        {
          "type": "lesson",
          "text": {
            "ar": "وأن التيسير والتبشير منهج الدعوة والولاية."
          }
        },
        {
          "type": "lesson",
          "text": {
            "ar": "وأن التكافل عند الشدة من علامات الجماعة المؤمنة."
          }
        }
      ]
    }
  ],
