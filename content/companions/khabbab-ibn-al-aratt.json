  "sections": [
    {
      "id": "khabbab-ibn-al-aratt.islam",
      "kind": "conversion",
      "title": {
        "ar": "إسلامه وصبره"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "أسلم خبّاب في أول الدعوة، ويذكر مجاهد أنه من أول من أظهر إسلامه، ويذكر ابن إسحاق أنه أسلم بعد تسعة عشر إنسانًا فكان تمام العشرين."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "324"
            },
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "324"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وكان قينًا يعمل الحديد بمكة، فعمل للعاص بن وائل عملًا، فلما جاءه يتقاضاه أبى أن يعطيه حتى يكفر بمحمد ﷺ، فأبى خبّاب، فسخر منه العاص، ونزل في ذلك قوله تعالى: ﴿أفرأيت الذي كفر بآياتنا﴾، كما يروي خبّاب نفسه."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "2091"
            },
            {
              "sourceId": "quran",
              "locatorStatus": "complete",
              "quranRef": {
                "surah": 19,
                "ayahFrom": 77
              }
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "واشتد أذى قريش عليه وعلى المستضعفين، فجاء هو وأصحابه إلى النبي ﷺ وهو متوسّد بردة في ظل الكعبة يسألونه أن يستنصر لهم ويدعو، فذكّرهم بمن كان قبلهم يُحفر له في الأرض ويُنشر بالمنشار فلا يصدّه ذلك عن دينه، وأخبرهم أن الله سيتمّ هذا الأمر حتى يسير الراكب من صنعاء إلى حضرموت لا يخاف إلا الله، ولكنهم يستعجلون."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3612"
            }
          ]
        }
      ]
    },
    {
      "id": "khabbab-ibn-al-aratt.hijrah",
      "kind": "withProphet",
      "title": {
        "ar": "الهجرة والمشاهد"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "هاجر خبّاب إلى المدينة، وكان يذكر أنهم هاجروا مع النبي ﷺ يبتغون وجه الله، فوقع أجرهم على الله، فمنهم من مضى ولم يأخذ من أجره شيئًا كمصعب بن عمير، ومنهم من أينعت له ثمرته فهو يجنيها."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3897"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وشهد بدرًا والمشاهد كلها مع رسول الله ﷺ."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "323"
            }
          ]
        }
      ]
    },
    {
      "id": "khabbab-ibn-al-aratt.later-life",
      "kind": "death",
      "title": {
        "ar": "آخر حياته ووفاته"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "أصابه في آخر عمره مرض شديد، فاكتوى في بطنه سبع كيّات، فعاده أصحابه، فذكر أنه لولا أن النبي ﷺ نهاهم أن يدعوا بالموت لدعا به."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "5672"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وذكر لهم أن أصحابه الذين سلفوا مضوا ولم تنقصهم الدنيا شيئًا، وأنهم أصابوا من المال بعدهم ما لا يجدون له موضعًا إلا التراب، وكان يخشى أن يكون ذلك مما عُجّل لهم."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "5672"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ويذكر الذهبي أن من قال إنه مات في خلافة عمر لم يُصب، وأنه مات بالكوفة سنة سبع وثلاثين، وصلّى عليه علي بن أبي طالب، وقيل عاش ثلاثًا وسبعين سنة."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "323"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ويُروى أن عمر بن الخطاب أدناه في مجلسه وذكر أنه ما أحد أحق بذلك المجلس منه إلا عمار بن ياسر."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 1,
              "page": "421"
            }
          ]
        }
      ]
    },
    {
      "id": "khabbab-ibn-al-aratt.lessons",
      "kind": "lessons",
      "title": {
        "ar": "دروس من سيرته"
      },
      "blocks": [
        {
          "type": "lesson",
          "text": {
            "ar": "أن الصبر على الأذى سنة الأنبياء وأتباعهم، وأن النصر يأتي في وقته لا في وقت استعجال الناس."
          }
        },
        {
          "type": "lesson",
          "text": {
            "ar": "وأن الصحابي كان يخاف على نفسه من سعة الدنيا أكثر مما كان يخاف من شدتها."
          }
        },
        {
          "type": "lesson",
          "text": {
            "ar": "وأن المسلم لا يتمنى الموت لضرّ نزل به، امتثالًا لنهي النبي ﷺ."
          }
        }
      ]
    }
  ],
