  "sections": [
    {
      "id": "ubayy-ibn-kab.life",
      "kind": "conversion",
      "title": {
        "ar": "إسلامه وعلمه"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "كان أبي بن كعب من الأنصار، شهد العقبة وبدرًا، وجمع القرآن في حياة النبي ﷺ، وكان يُكنى أبا المنذر، ويُكنى أيضًا أبا الطفيل، على ما يذكر الذهبي."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 1,
              "page": "390"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وكان أنس يعدّه في الأربعة من الأنصار الذين جمعوا القرآن على عهد النبي ﷺ، وأمر النبي ﷺ أن يؤخذ القرآن من أربعة هو أحدهم."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3810"
            },
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3758"
            }
          ]
        }
      ]
    },
    {
      "id": "ubayy-ibn-kab.virtues",
      "kind": "virtues",
      "title": {
        "ar": "من فضائله"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "أخبره النبي ﷺ أن الله أمره أن يقرأ عليه سورة البينة، فسأله أبي: وسمّاني لك؟ فقال: نعم، فبكى أبي."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "4959"
            },
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3809"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وسأله النبي ﷺ عن أعظم آية في كتاب الله، فذكر آية الكرسي، فضرب في صدره وقال: ليهنك العلم أبا المنذر، كما في صحيح مسلم."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "muslim",
              "locatorStatus": "complete",
              "hadithNumber": "810"
            },
            {
              "sourceId": "quran",
              "locatorStatus": "complete",
              "quranRef": {
                "surah": 2,
                "ayahFrom": 255
              }
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ويروي الترمذي عن أنس أن النبي ﷺ ذكر أن أقرأ أصحابه لكتاب الله أبي بن كعب، ويصحّحه."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "tirmidhi",
              "locatorStatus": "complete",
              "hadithNumber": "3791"
            }
          ]
        }
      ]
    },
    {
      "id": "ubayy-ibn-kab.after",
      "kind": "contributions",
      "title": {
        "ar": "بعد النبي ﷺ"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "خرج عمر بن الخطاب ليلة في رمضان إلى المسجد، فوجد الناس يصلّون متفرّقين، فرأى أن يجمعهم على قارئ واحد، فجمعهم على أبي بن كعب."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "2010"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ويذكر الذهبي أن من رآه يوم موته سمع الناس يقولون: مات اليوم سيد المسلمين، وأن عمر قال ذلك."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 1,
              "page": "399"
            }
          ]
        }
      ]
    },
    {
      "id": "ubayy-ibn-kab.death",
      "kind": "death",
      "title": {
        "ar": "وفاته"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "اختلف المؤرخون في سنة وفاته؛ فذكر الواقدي أن أهله يقولون سنة اثنتين وعشرين، وأنه سمع من يقول في خلافة عثمان سنة ثلاثين، وقيل سنة تسع عشرة، ويميل الذهبي إلى سنة اثنتين وعشرين."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 1,
              "page": "400"
            },
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 1,
              "page": "400"
            }
          ]
        }
      ]
    },
    {
      "id": "ubayy-ibn-kab.lessons",
      "kind": "lessons",
      "title": {
        "ar": "دروس من سيرته"
      },
      "blocks": [
        {
          "type": "lesson",
          "text": {
            "ar": "أن حامل القرآن تُرفع منزلته به، حتى أمر الله نبيه أن يقرأ عليه."
          }
        },
        {
          "type": "lesson",
          "text": {
            "ar": "وأن الفرح بالعلم والخشية عند ذكر الله من صفات أهل القرآن، فقد بكى أبي حين سُمّي."
          }
        },
        {
          "type": "lesson",
          "text": {
            "ar": "وأن جمع الناس على إمام واحد في العبادة من حسن الرأي الذي سنّه عمر."
          }
        }
      ]
    }
  ],
