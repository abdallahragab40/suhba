  "sections": [
    {
      "id": "abu-bakr.early-life",
      "kind": "earlyLife",
      "title": {
        "ar": "النشأة"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "نشأ أبو بكر بمكة في بني تيم بن مرة من قريش، وعُرف قبل الإسلام بالتجارة."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "isabah",
              "locatorStatus": "pending"
            },
            {
              "sourceId": "siyar",
              "locatorStatus": "pending"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وكان من أعلم قريش بأنسابها."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "muslim",
              "locatorStatus": "pending"
            }
          ]
        }
      ]
    },
    {
      "id": "abu-bakr.conversion",
      "kind": "conversion",
      "title": {
        "ar": "إسلامه"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "كان من أوائل من أسلم، وهو أول من أسلم من الرجال الأحرار على قول كثير من أهل العلم."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "pending"
            },
            {
              "sourceId": "isabah",
              "locatorStatus": "pending"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وأسلم بدعوته عدد من السابقين، منهم عثمان بن عفان والزبير بن العوام وعبد الرحمن بن عوف وسعد بن أبي وقاص وطلحة بن عبيد الله."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "sirat-ibn-hisham",
              "locatorStatus": "pending"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "واشترى بلال بن رباح فأعتقه."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "pending"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وكان بلال ممن عُذِّبوا بمكة بسبب إسلامهم."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "sirat-ibn-hisham",
              "locatorStatus": "pending"
            }
          ]
        }
      ]
    },
    {
      "id": "abu-bakr.hijrah",
      "kind": "withProphet",
      "title": {
        "ar": "صاحبه في الهجرة"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "صحب النبيَّ ﷺ في هجرته من مكة إلى المدينة، واختبآ ثلاث ليالٍ في غارٍ بجبل ثور قبل أن يمضيا في طريقهما."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "pending"
            }
          ]
        },
        {
          "type": "quranQuote",
          "ref": {
            "surah": 9,
            "ayahFrom": 40
          }
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وفي هذه الآية ذكرُ صحبته للنبي ﷺ في الغار، كما جاء في الحديث الصحيح."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "pending"
            }
          ]
        },
        {
          "type": "hadithQuote",
          "textStatus": "pendingFromSource",
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "pending",
              "grading": {
                "grade": "sahih",
                "gradedBy": {
                  "ar": "البخاري، بإخراجه في صحيحه"
                }
              }
            },
            {
              "sourceId": "muslim",
              "locatorStatus": "pending",
              "grading": {
                "grade": "sahih",
                "gradedBy": {
                  "ar": "مسلم، بإخراجه في صحيحه"
                }
              }
            }
          ],
          "summary": {
            "ar": "حديث أبي بكر عمّا قاله للنبي ﷺ وهما في الغار، وما طمأنه به النبي ﷺ من معيّة الله لهما."
          }
        }
      ]
    },
    {
      "id": "abu-bakr.virtues",
      "kind": "virtues",
      "title": {
        "ar": "فضائله"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "ووصفه النبي ﷺ بالصدّيق في حديث صحيح."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "pending"
            }
          ]
        },
        {
          "type": "hadithQuote",
          "textStatus": "pendingFromSource",
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "pending",
              "grading": {
                "grade": "sahih",
                "gradedBy": {
                  "ar": "البخاري، بإخراجه في صحيحه"
                }
              }
            },
            {
              "sourceId": "muslim",
              "locatorStatus": "pending",
              "grading": {
                "grade": "sahih",
                "gradedBy": {
                  "ar": "مسلم، بإخراجه في صحيحه"
                }
              }
            }
          ],
          "summary": {
            "ar": "حديث النبي ﷺ في منزلة أبي بكر عنده، وأنه لو كان متخذًا خليلًا من أمته لاتخذ أبا بكر."
          }
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ولما اشتد المرض بالنبي ﷺ أمر أن يصلي أبو بكر بالناس."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "pending"
            },
            {
              "sourceId": "muslim",
              "locatorStatus": "pending"
            }
          ]
        }
      ]
    },
    {
      "id": "abu-bakr.caliphate",
      "kind": "contributions",
      "title": {
        "ar": "خلافته"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "بويع بالخلافة بعد وفاة النبي ﷺ سنة إحدى عشرة للهجرة، فكان أول الخلفاء الراشدين."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "pending"
            },
            {
              "sourceId": "tarikh-al-tabari",
              "locatorStatus": "pending"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وواجه في خلافته حروب الردة ومنع الزكاة، وثبت على قتال من فرّق بين الصلاة والزكاة."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "pending"
            },
            {
              "sourceId": "tarikh-al-tabari",
              "locatorStatus": "pending"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وبأمره جُمع القرآن في صحف بعد معركة اليمامة، وتولّى الجمعَ زيد بن ثابت."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "pending"
            }
          ]
        }
      ]
    },
    {
      "id": "abu-bakr.death",
      "kind": "death",
      "title": {
        "ar": "وفاته"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "توفي بالمدينة في جمادى الآخرة سنة ثلاث عشرة للهجرة، ودُفن إلى جانب النبي ﷺ."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "isabah",
              "locatorStatus": "pending"
            },
            {
              "sourceId": "siyar",
              "locatorStatus": "pending"
            }
          ]
        }
      ]
    },
    {
      "id": "abu-bakr.lessons",
      "kind": "lessons",
      "title": {
        "ar": "دروس وعبر"
      },
      "blocks": [
        {
          "type": "lesson",
          "text": {
            "ar": "تُظهر سيرته أن الصحبة الصادقة تُعرف في الشدائد، وأن الثبات على الحق عند اضطراب الناس من أعظم ما يُخدم به الدين."
          }
        }
      ]
    }
  ],
