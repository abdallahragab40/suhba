  "sections": [
    {
      "id": "hudhayfah-ibn-al-yaman.father",
      "kind": "withProphet",
      "title": {
        "ar": "يوم أحد"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "شهد حذيفة أحدًا مع أبيه اليمان، فالتبس اليمان على المسلمين في القتال فقتلوه خطأً، فجعل حذيفة ينادي: أي عباد الله، أبي أبي، فلم ينتهوا حتى قتلوه، فقال: يغفر الله لكم، فما زالت في حذيفة منه بقية خير حتى لقي الله."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3290"
            },
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3824"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ويذكر حذيفة أنه لم يمنعه أن يشهد بدرًا إلا أنه خرج هو وأبوه فأخذهم كفار قريش، فأخذوا عليهم عهدًا ألّا يقاتلوا مع النبي ﷺ، فأمرهم النبي ﷺ أن يفوا لهم."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "364"
            }
          ]
        }
      ]
    },
    {
      "id": "hudhayfah-ibn-al-yaman.the-trench",
      "kind": "withProphet",
      "title": {
        "ar": "ليلة الأحزاب"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "في ليلة شديدة البرد من ليالي الأحزاب سأل النبي ﷺ من يأتيه بخبر القوم، فلم يجبه أحد، فقال: قم يا حذيفة فأتنا بخبر القوم، فذهب حتى دخل معسكرهم، ثم رجع إليه بالخبر، كما يروي في صحيح مسلم."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "muslim",
              "locatorStatus": "complete",
              "hadithNumber": "1788"
            }
          ]
        }
      ]
    },
    {
      "id": "hudhayfah-ibn-al-yaman.the-secret",
      "kind": "virtues",
      "title": {
        "ar": "صاحب السرّ"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "كان الناس يسألون النبي ﷺ عن الخير، وكان حذيفة يسأله عن الشر مخافة أن يدركه، فحدّثه بالفتن وما يكون فيها، وبما يعتصم به المسلم منها."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3606"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وكان أبو الدرداء يذكر لأهل الكوفة أن فيهم صاحب سرّ النبي ﷺ الذي لا يعلمه غيره، يعني حذيفة."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3743"
            }
          ]
        }
      ]
    },
    {
      "id": "hudhayfah-ibn-al-yaman.madain",
      "kind": "contributions",
      "title": {
        "ar": "أمير المدائن ووفاته"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "ولّاه عمر المدائن، وكتب في عهده إليهم أن يسمعوا له ويطيعوا، فخرج إليها على حمار عليه زاده، فلما قدم استقبله الدهاقين وبيده رغيف وعَرْق من لحم، على ما يرويه الذهبي."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "363"
            },
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "363"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وبقي عليها إلى ما بعد مقتل عثمان، وتوفي بعده بأربعين ليلة، بالمدائن سنة ست وثلاثين."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "364"
            },
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "366"
            }
          ]
        }
      ]
    },
    {
      "id": "hudhayfah-ibn-al-yaman.lessons",
      "kind": "lessons",
      "title": {
        "ar": "دروس من سيرته"
      },
      "blocks": [
        {
          "type": "lesson",
          "text": {
            "ar": "أن معرفة الشر للحذر منه من الحكمة، كما أن معرفة الخير للعمل به."
          }
        },
        {
          "type": "lesson",
          "text": {
            "ar": "وأن العفو عند المصيبة من أعلى مقامات الصبر، فقد عفا حذيفة عمّن قتل أباه خطأً."
          }
        },
        {
          "type": "lesson",
          "text": {
            "ar": "وأن الوفاء بالعهد خلق لازم حتى مع العدو."
          }
        }
      ]
    }
  ],
