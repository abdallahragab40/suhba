  "sections": [
    {
      "id": "juwayriyah.marriage",
      "kind": "withProphet",
      "title": {
        "ar": "زواجها من النبي ﷺ"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "سُبيت جويرية بنت الحارث يوم غزوة المريسيع، ويذكر الذهبي أن ذلك كان في السنة الخامسة، وأن أباها كان سيدًا مطاعًا في قومه."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "261"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وتروي عائشة أنها وقعت في سهم ثابت بن قيس بن شماس أو ابن عم له، فكاتبته على نفسها، ثم جاءت النبي ﷺ تستعينه في كتابتها، فقال: فهل لك إلى ما هو خير منه؟ أؤدي عنك كتابتك وأتزوجك. قالت: قد فعلت. فلما تسامع الناس أن رسول الله ﷺ تزوجها أرسلوا ما في أيديهم من السبي فأعتقوهم، وقالوا: أصهار رسول الله ﷺ. قالت عائشة: فما رأينا امرأة كانت أعظم بركة على قومها منها، أُعتق في سببها مائة أهل بيت من بني المصطلق."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "abu-dawud",
              "locatorStatus": "complete",
              "hadithNumber": "3931"
            },
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "265"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ويُروى عنها أنها قالت: تزوجني رسول الله ﷺ وأنا بنت عشرين سنة."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "263"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وكان اسمها برّة، فحوّل رسول الله ﷺ اسمها جويرية، وكان يكره أن يقال: خرج من عند برّة."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "muslim",
              "locatorStatus": "complete",
              "hadithNumber": "2140"
            }
          ]
        }
      ]
    },
    {
      "id": "juwayriyah.worship",
      "kind": "character",
      "title": {
        "ar": "عبادتها"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "خرج النبي ﷺ من عندها بكرة حين صلى الصبح وهي في مسجدها، ثم رجع بعد أن أضحى وهي جالسة، فقال: ما زلت على الحال التي فارقتك عليها؟ قالت: نعم. فقال: لقد قلت بعدك أربع كلمات ثلاث مرات، لو وُزنت بما قلت منذ اليوم لوزنتهن: سبحان الله وبحمده، عدد خلقه، ورضا نفسه، وزنة عرشه، ومداد كلماته."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "muslim",
              "locatorStatus": "complete",
              "hadithNumber": "2726"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ودخل عليها النبي ﷺ يوم الجمعة وهي صائمة، فقال: أصمت أمس؟ قالت: لا. قال: تريدين أن تصومي غدًا؟ قالت: لا. قال: فأفطري."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "1986"
            }
          ]
        }
      ]
    },
    {
      "id": "juwayriyah.death",
      "kind": "death",
      "title": {
        "ar": "وفاتها"
      },
      "blocks": [
        {
          "type": "disputeNote",
          "text": {
            "ar": "اختُلف في سنة وفاتها."
          },
          "opinions": [
            {
              "text": {
                "ar": "توفيت سنة خمسين."
              },
              "citations": [
                {
                  "sourceId": "siyar",
                  "locatorStatus": "complete",
                  "volume": 2,
                  "page": "263"
                }
              ]
            },
            {
              "text": {
                "ar": "توفيت سنة ست وخمسين."
              },
              "citations": [
                {
                  "sourceId": "siyar",
                  "locatorStatus": "complete",
                  "volume": 2,
                  "page": "263"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "juwayriyah.lessons",
      "kind": "lessons",
      "title": {
        "ar": "دروس من سيرتها"
      },
      "blocks": [
        {
          "type": "lesson",
          "text": {
            "ar": "أن الله قد يجعل في امرأة واحدة بركة يعمّ نفعها قومها."
          }
        },
        {
          "type": "lesson",
          "text": {
            "ar": "وأن الذكر الجامع القليل قد يرجح بالكثير، كما علّم النبي ﷺ جويرية."
          }
        }
      ]
    }
  ],
