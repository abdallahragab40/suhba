  "sections": [
    {
      "id": "khadijah.before",
      "kind": "earlyLife",
      "title": {
        "ar": "قبل البعثة"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "هي خديجة بنت خويلد بن أسد بن عبد العزى بن قصي، القرشية الأسدية، تلتقي مع النبي ﷺ في جدّه قصي بن كلاب. وأمها فاطمة بنت زائدة بن الأصم، من بني عامر بن لؤي."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "sirat-ibn-hisham",
              "locatorStatus": "complete",
              "volume": 1,
              "page": "189"
            },
            {
              "sourceId": "tabaqat-ibn-sad",
              "locatorStatus": "complete",
              "volume": 8,
              "page": "11"
            },
            {
              "sourceId": "usd-al-ghabah",
              "locatorStatus": "complete",
              "volume": 5,
              "page": "434"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وكانت تُدعى في الجاهلية «الطاهرة»، على ما يذكر الزبير بن بكار، وكانت من أشراف قريش وذوات المال فيهم."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "usd-al-ghabah",
              "locatorStatus": "complete",
              "volume": 5,
              "page": "434"
            },
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "111"
            },
            {
              "sourceId": "sirat-ibn-hisham",
              "locatorStatus": "complete",
              "volume": 1,
              "page": "187"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وتزوّجت قبل النبي ﷺ مرتين: بأبي هالة التميمي، وبعتيق المخزومي، وولدت لهما أولادًا، منهم هند وهالة ابنا أبي هالة، وهند بنت عتيق."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "tabaqat-ibn-sad",
              "locatorStatus": "complete",
              "volume": 8,
              "page": "11"
            },
            {
              "sourceId": "usd-al-ghabah",
              "locatorStatus": "complete",
              "volume": 5,
              "page": "434"
            }
          ]
        },
        {
          "type": "disputeNote",
          "text": {
            "ar": "واختُلف في أيّ زوجيها كان أولًا."
          },
          "opinions": [
            {
              "text": {
                "ar": "أبو هالة ثم عتيق، على ما يذكر ابن سعد والذهبي، ونقله ابن عبد البر عن الزبير بن بكار وقال إنه أصح."
              },
              "citations": [
                {
                  "sourceId": "tabaqat-ibn-sad",
                  "locatorStatus": "complete",
                  "volume": 8,
                  "page": "11"
                },
                {
                  "sourceId": "siyar",
                  "locatorStatus": "complete",
                  "volume": 2,
                  "page": "111"
                },
                {
                  "sourceId": "usd-al-ghabah",
                  "locatorStatus": "complete",
                  "volume": 5,
                  "page": "434"
                }
              ]
            },
            {
              "text": {
                "ar": "عتيق ثم أبو هالة، وهو قول قتادة وابن إسحاق، وكذلك هو في كتاب الزبير بن بكار في نسب قريش، على ما يذكر ابن الأثير."
              },
              "citations": [
                {
                  "sourceId": "usd-al-ghabah",
                  "locatorStatus": "complete",
                  "volume": 5,
                  "page": "434"
                },
                {
                  "sourceId": "usd-al-ghabah",
                  "locatorStatus": "complete",
                  "volume": 5,
                  "page": "435"
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ويذكر ابن إسحاق أنها كانت امرأة تاجرة، تستأجر الرجال في مالها وتجعل لهم شيئًا منه، فلما بلغها صدق حديث النبي ﷺ وعظم أمانته وكرم أخلاقه عرضت عليه أن يخرج في مالها إلى الشام تاجرًا مع غلام لها يقال له ميسرة، وتعطيه أفضل مما كانت تعطي غيره من التجار."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "sirat-ibn-hisham",
              "locatorStatus": "complete",
              "volume": 1,
              "page": "187"
            },
            {
              "sourceId": "sirat-ibn-hisham",
              "locatorStatus": "complete",
              "volume": 1,
              "page": "188"
            },
            {
              "sourceId": "usd-al-ghabah",
              "locatorStatus": "complete",
              "volume": 5,
              "page": "435"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "فلما رجع باعت ما جاء به فربحت ضعفه أو قريبًا منه، فرغبت فيه، وذكرت له، فيما يرويه ابن إسحاق، أنها رغبت فيه لقرابته منها، ومكانته في قومه، وأمانته، وحسن خلقه، وصدق حديثه، ثم عرضت عليه نفسها."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "sirat-ibn-hisham",
              "locatorStatus": "complete",
              "volume": 1,
              "page": "188"
            },
            {
              "sourceId": "sirat-ibn-hisham",
              "locatorStatus": "complete",
              "volume": 1,
              "page": "189"
            },
            {
              "sourceId": "usd-al-ghabah",
              "locatorStatus": "complete",
              "volume": 5,
              "page": "435"
            }
          ]
        }
      ]
    },
    {
      "id": "khadijah.marriage",
      "kind": "withProphet",
      "title": {
        "ar": "زواجها وبيتها"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "تزوّجها النبي ﷺ قبل البعثة، وهي أول امرأة تزوّجها، ولم يتزوّج عليها غيرها حتى ماتت."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "muslim",
              "locatorStatus": "complete",
              "hadithNumber": "2436"
            },
            {
              "sourceId": "sirat-ibn-hisham",
              "locatorStatus": "complete",
              "volume": 1,
              "page": "190"
            },
            {
              "sourceId": "usd-al-ghabah",
              "locatorStatus": "complete",
              "volume": 5,
              "page": "434"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وكان له ﷺ يومئذ خمس وعشرون سنة على المشهور، وكانت هي، على ما يذكر ابن سعد وابن الأثير، بنت أربعين سنة، وفي سنّها وسنّه أقوال أخرى."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "sirat-ibn-hisham",
              "locatorStatus": "complete",
              "volume": 1,
              "page": "187"
            },
            {
              "sourceId": "tabaqat-ibn-sad",
              "locatorStatus": "complete",
              "volume": 1,
              "page": "105"
            },
            {
              "sourceId": "usd-al-ghabah",
              "locatorStatus": "complete",
              "volume": 5,
              "page": "435"
            }
          ]
        },
        {
          "type": "disputeNote",
          "text": {
            "ar": "واختلفت الروايات في سنّها يوم تزوّجها."
          },
          "opinions": [
            {
              "text": {
                "ar": "أربعون سنة، وهو قول الواقدي، ويرويه ابن سعد عن حكيم بن حزام، وبه أخذ ابن الأثير."
              },
              "citations": [
                {
                  "sourceId": "tabaqat-ibn-sad",
                  "locatorStatus": "complete",
                  "volume": 8,
                  "page": "13"
                },
                {
                  "sourceId": "usd-al-ghabah",
                  "locatorStatus": "complete",
                  "volume": 5,
                  "page": "435"
                }
              ]
            },
            {
              "text": {
                "ar": "ثمان وعشرون سنة، فيما يرويه ابن سعد من طريق الكلبي عن ابن عباس، وذكره الذهبي."
              },
              "citations": [
                {
                  "sourceId": "tabaqat-ibn-sad",
                  "locatorStatus": "complete",
                  "volume": 8,
                  "page": "13"
                },
                {
                  "sourceId": "siyar",
                  "locatorStatus": "complete",
                  "volume": 2,
                  "page": "111"
                }
              ]
            },
            {
              "text": {
                "ar": "ونقل ابن كثير عن مصعب الزبيري أنها بلغت خمسًا وستين سنة، ويقال خمسين، وأن هذا أصح، فتكون على هذا القول دون الأربعين يوم زواجها."
              },
              "citations": [
                {
                  "sourceId": "al-bidaya",
                  "locatorStatus": "complete",
                  "volume": 3,
                  "page": "464"
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وأصدقها عشرين بَكْرة، على ما يذكر ابن هشام."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "sirat-ibn-hisham",
              "locatorStatus": "complete",
              "volume": 1,
              "page": "190"
            },
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "114"
            }
          ]
        },
        {
          "type": "disputeNote",
          "text": {
            "ar": "واختُلف فيمن زوّجها."
          },
          "opinions": [
            {
              "text": {
                "ar": "أبوها خويلد بن أسد: يذكر ابن إسحاق أن النبي ﷺ خرج مع عمه حمزة حتى دخل على خويلد فخطبها إليه."
              },
              "citations": [
                {
                  "sourceId": "sirat-ibn-hisham",
                  "locatorStatus": "complete",
                  "volume": 1,
                  "page": "189"
                },
                {
                  "sourceId": "sirat-ibn-hisham",
                  "locatorStatus": "complete",
                  "volume": 1,
                  "page": "190"
                }
              ]
            },
            {
              "text": {
                "ar": "عمها عمرو بن أسد، لأن أباها مات قبل حرب الفجار، ويقول الواقدي إن هذا هو المجتمع عليه عند أصحابه."
              },
              "citations": [
                {
                  "sourceId": "tabaqat-ibn-sad",
                  "locatorStatus": "complete",
                  "volume": 1,
                  "page": "105"
                },
                {
                  "sourceId": "siyar",
                  "locatorStatus": "complete",
                  "volume": 2,
                  "page": "110"
                },
                {
                  "sourceId": "siyar",
                  "locatorStatus": "complete",
                  "volume": 2,
                  "page": "111"
                },
                {
                  "sourceId": "usd-al-ghabah",
                  "locatorStatus": "complete",
                  "volume": 5,
                  "page": "435"
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وأقامت معه، على ما يذكر ابن الأثير، أربعًا وعشرين سنة."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "usd-al-ghabah",
              "locatorStatus": "complete",
              "volume": 5,
              "page": "435"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وولدت له أولاده كلهم إلا إبراهيم: القاسم وبه كان يُكنى، وزينب ورقية وأم كلثوم وفاطمة، ومات بنوها منه صغارًا، وأدركت بناتها الإسلام فأسلمن وهاجرن."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "sirat-ibn-hisham",
              "locatorStatus": "complete",
              "volume": 1,
              "page": "190"
            },
            {
              "sourceId": "sirat-ibn-hisham",
              "locatorStatus": "complete",
              "volume": 1,
              "page": "191"
            },
            {
              "sourceId": "tabaqat-ibn-sad",
              "locatorStatus": "complete",
              "volume": 1,
              "page": "106"
            },
            {
              "sourceId": "usd-al-ghabah",
              "locatorStatus": "complete",
              "volume": 5,
              "page": "436"
            }
          ]
        },
        {
          "type": "disputeNote",
          "text": {
            "ar": "واختلفت الروايات في عدد بنيه منها وأسمائهم."
          },
          "opinions": [
            {
              "text": {
                "ar": "ابنان: القاسم وعبد الله، وهو قول قتادة؛ ويذكر الزبير بن بكار أن عبد الله كان يقال له الطيب ويقال له الطاهر، وبمعناه رواية الكلبي عند ابن سعد، وفيها أنه سُمّي بذلك لأنه وُلد في الإسلام."
              },
              "citations": [
                {
                  "sourceId": "usd-al-ghabah",
                  "locatorStatus": "complete",
                  "volume": 5,
                  "page": "436"
                },
                {
                  "sourceId": "tabaqat-ibn-sad",
                  "locatorStatus": "complete",
                  "volume": 1,
                  "page": "106"
                },
                {
                  "sourceId": "al-bidaya",
                  "locatorStatus": "complete",
                  "volume": 3,
                  "page": "465"
                }
              ]
            },
            {
              "text": {
                "ar": "ثلاثة: القاسم والطاهر والطيب، على ما يذكر ابن إسحاق، وأنهم هلكوا في الجاهلية."
              },
              "citations": [
                {
                  "sourceId": "sirat-ibn-hisham",
                  "locatorStatus": "complete",
                  "volume": 1,
                  "page": "190"
                },
                {
                  "sourceId": "usd-al-ghabah",
                  "locatorStatus": "complete",
                  "volume": 5,
                  "page": "435"
                },
                {
                  "sourceId": "siyar",
                  "locatorStatus": "complete",
                  "volume": 2,
                  "page": "114"
                }
              ]
            },
            {
              "text": {
                "ar": "أربعة: القاسم والطاهر والطيب وعبد الله، فيما يرويه الزبير بن بكار عن أبي الأسود."
              },
              "citations": [
                {
                  "sourceId": "usd-al-ghabah",
                  "locatorStatus": "complete",
                  "volume": 5,
                  "page": "436"
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وكان زيد بن حارثة مملوكًا لها، اختارته من رقيق قدم بهم ابن أخيها حكيم بن حزام، فاستوهبه النبي ﷺ منها فوهبته له، فأعتقه وتبنّاه، وذلك قبل أن يوحى إليه، على ما يذكر ابن هشام."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "sirat-ibn-hisham",
              "locatorStatus": "complete",
              "volume": 1,
              "page": "247"
            },
            {
              "sourceId": "sirat-ibn-hisham",
              "locatorStatus": "complete",
              "volume": 1,
              "page": "248"
            },
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 1,
              "page": "223"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ولما حُبّب إلى النبي ﷺ الخلاء كان يخلو بغار حراء يتعبّد الليالي ذوات العدد، ثم يرجع إلى خديجة فيتزوّد لمثلها."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3"
            }
          ]
        }
      ]
    },
    {
      "id": "khadijah.first-believer",
      "kind": "conversion",
      "title": {
        "ar": "أول من آمن"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "لما نزل الوحي أول مرة رجع النبي ﷺ إلى خديجة يرجف فؤاده، فقال: زمّلوني، فزمّلوه حتى ذهب عنه الرَّوع، فأخبرها الخبر، وذكر أنه خشي على نفسه، فطمأنته بما عرفت من أخلاقه."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3"
            }
          ]
        },
        {
          "type": "reportQuote",
          "textStatus": "complete",
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3"
            }
          ],
          "text": {
            "ar": "كَلاَّ وَاللَّهِ مَا يُخْزِيكَ اللَّهُ أَبَدًا، إِنَّكَ لَتَصِلُ الرَّحِمَ، وَتَحْمِلُ الْكَلَّ، وَتَكْسِبُ الْمَعْدُومَ، وَتَقْرِي الضَّيْفَ، وَتُعِينُ عَلَى نَوَائِبِ الْحَقِّ"
          },
          "summary": {
            "ar": "قول خديجة للنبي ﷺ أول الوحي، تطمئنه بما عرفت من أخلاقه."
          }
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ثم انطلقت به إلى ابن عمها ورقة بن نوفل، وكان قد تنصّر في الجاهلية، وكان يكتب من الإنجيل، فأخبره النبي ﷺ خبر ما رأى، فقال له ورقة: هذا الناموس الذي نزّله الله على موسى."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وكانت خديجة أول من آمن بالنبي ﷺ وصدّقه قبل كل أحد، ويذكر ابن الأثير أن ذلك بإجماع المسلمين، لم يتقدّمها رجل ولا امرأة."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "109"
            },
            {
              "sourceId": "usd-al-ghabah",
              "locatorStatus": "complete",
              "volume": 5,
              "page": "434"
            },
            {
              "sourceId": "sirat-ibn-hisham",
              "locatorStatus": "complete",
              "volume": 1,
              "page": "240"
            },
            {
              "sourceId": "tabaqat-ibn-sad",
              "locatorStatus": "complete",
              "volume": 8,
              "page": "13"
            }
          ]
        }
      ]
    },
    {
      "id": "khadijah.support",
      "kind": "contributions",
      "title": {
        "ar": "سند الدعوة في مكة"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "يذكر ابن إسحاق أن خديجة آمنت به ووازرته على أمره، فخفّف الله بها عن نبيه ﷺ، فكان لا يسمع شيئًا يكرهه من ردّ عليه وتكذيب له إلا فرّج الله عنه بها إذا رجع إليها: تثبّته، وتخفّف عنه، وتصدّقه، وتهوّن عليه أمر الناس."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "sirat-ibn-hisham",
              "locatorStatus": "complete",
              "volume": 1,
              "page": "240"
            },
            {
              "sourceId": "usd-al-ghabah",
              "locatorStatus": "complete",
              "volume": 5,
              "page": "437"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وكانت تنفق عليه من مالها، ويتّجر هو لها، على ما يذكر الذهبي."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "110"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ولما حوصر بنو هاشم وبنو المطلب في شعب أبي طالب كانت معه ﷺ في الشِّعب، ويذكر ابن إسحاق أن أبا جهل لقي ابن أخيها حكيم بن حزام ومعه غلام يحمل قمحًا يريد به عمته خديجة، فتعلّق به يمنعه، حتى جاء أبو البختري بن هاشم فقال: طعام كان لعمته عنده، أفتمنعه أن يأتيها بطعامها؟"
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "sirat-ibn-hisham",
              "locatorStatus": "complete",
              "volume": 1,
              "page": "351"
            },
            {
              "sourceId": "sirat-ibn-hisham",
              "locatorStatus": "complete",
              "volume": 1,
              "page": "353"
            },
            {
              "sourceId": "sirat-ibn-hisham",
              "locatorStatus": "complete",
              "volume": 1,
              "page": "354"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ويصفها ابن إسحاق بأنها كانت للنبي ﷺ وزير صدق على الإسلام، يشكو إليها."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "sirat-ibn-hisham",
              "locatorStatus": "complete",
              "volume": 1,
              "page": "416"
            },
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "114"
            },
            {
              "sourceId": "usd-al-ghabah",
              "locatorStatus": "complete",
              "volume": 5,
              "page": "439"
            }
          ]
        }
      ]
    },
    {
      "id": "khadijah.virtues",
      "kind": "virtues",
      "title": {
        "ar": "من فضائلها"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "أخبر النبي ﷺ أن خير نسائها مريم ابنة عمران، وخير نسائها خديجة، أي خير نساء زمانها."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3815"
            },
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3432"
            },
            {
              "sourceId": "muslim",
              "locatorStatus": "complete",
              "hadithNumber": "2430"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وفي سنن الترمذي عن أنس أن النبي ﷺ قال: «حسبك من نساء العالمين مريم ابنة عمران، وخديجة بنت خويلد، وفاطمة بنت محمد، وآسية امرأة فرعون»، وقال الترمذي: هذا حديث صحيح."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "tirmidhi",
              "locatorStatus": "complete",
              "hadithNumber": "3878",
              "grading": {
                "grade": "sahih",
                "gradedBy": {
                  "ar": "الترمذي في سننه"
                }
              }
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وأتى جبريل النبي ﷺ فأخبره أن خديجة آتية إليه، وأمره أن يقرأ عليها السلام من ربها ومنه، ويبشّرها ببيت في الجنة، كما يروي أبو هريرة:"
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3820"
            },
            {
              "sourceId": "muslim",
              "locatorStatus": "complete",
              "hadithNumber": "2432"
            }
          ]
        },
        {
          "type": "hadithQuote",
          "textStatus": "complete",
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3820",
              "grading": {
                "grade": "sahih",
                "gradedBy": {
                  "ar": "البخاري، بإخراجه في صحيحه"
                }
              }
            },
            {
              "sourceId": "muslim",
              "locatorStatus": "complete",
              "hadithNumber": "2432",
              "grading": {
                "grade": "sahih",
                "gradedBy": {
                  "ar": "مسلم، بإخراجه في صحيحه"
                }
              }
            }
          ],
          "text": {
            "ar": "هَذِهِ خَدِيجَةُ قَدْ أَتَتْ مَعَهَا إِنَاءٌ فِيهِ إِدَامٌ أَوْ طَعَامٌ أَوْ شَرَابٌ، فَإِذَا هِيَ أَتَتْكَ فَاقْرَأْ عَلَيْهَا السَّلاَمَ مِنْ رَبِّهَا وَمِنِّي، وَبَشِّرْهَا بِبَيْتٍ فِي الْجَنَّةِ مِنْ قَصَبٍ، لاَ صَخَبَ فِيهِ وَلاَ نَصَبَ"
          },
          "summary": {
            "ar": "قول جبريل للنبي ﷺ: هذه خديجة آتية، فاقرأ عليها السلام من ربها ومني، وبشّرها ببيت في الجنة من قصب."
          }
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وسُئل عبد الله بن أبي أوفى: أبشّر النبي ﷺ خديجة؟ فقال: نعم، ببيت من قصب، لا صخب فيه ولا نصب."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3819"
            },
            {
              "sourceId": "muslim",
              "locatorStatus": "complete",
              "hadithNumber": "2433"
            }
          ]
        }
      ]
    },
    {
      "id": "khadijah.loyalty",
      "kind": "character",
      "title": {
        "ar": "وفاء النبي ﷺ لها"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "كانت عائشة تذكر أنها ما غارت على امرأة ما غارت على خديجة، وهي لم ترها، لكثرة ما كان النبي ﷺ يذكرها، وأنه ربما ذبح الشاة فقطّعها أعضاء ثم بعث بها إلى صديقات خديجة، فإذا قالت له في ذلك ذكر أنها كانت وكانت، وأنه كان له منها الولد."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3818"
            },
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3816"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وتروي عائشة أنها أغضبته يومًا حين ذكرت خديجة، فقال ﷺ:"
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "muslim",
              "locatorStatus": "complete",
              "hadithNumber": "2435"
            }
          ]
        },
        {
          "type": "hadithQuote",
          "textStatus": "complete",
          "reliability": "established",
          "citations": [
            {
              "sourceId": "muslim",
              "locatorStatus": "complete",
              "hadithNumber": "2435",
              "grading": {
                "grade": "sahih",
                "gradedBy": {
                  "ar": "مسلم، بإخراجه في صحيحه"
                }
              }
            }
          ],
          "text": {
            "ar": "إِنِّي قَدْ رُزِقْتُ حُبَّهَا"
          },
          "summary": {
            "ar": "قول النبي ﷺ في خديجة: إني قد رُزقت حبّها، كما ترويه عائشة في صحيح مسلم."
          }
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "واستأذنت عليه يومًا هالة بنت خويلد أخت خديجة، فعرف فيه استئذان خديجة، فارتاع لذلك، وفي رواية مسلم: فارتاح، وقال: اللهم هالة، كما تروي عائشة."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3821"
            },
            {
              "sourceId": "muslim",
              "locatorStatus": "complete",
              "hadithNumber": "2437"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ويروي الذهبي وابن الأثير أن عائشة ذكرتها مرة بما يغضّ منها، فغضب النبي ﷺ، وذكر أنها آمنت به إذ كذّبه الناس، وواسته بمالها إذ حرمه الناس، ورُزق منها الولد."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "112"
            },
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "117"
            },
            {
              "sourceId": "usd-al-ghabah",
              "locatorStatus": "complete",
              "volume": 5,
              "page": "438"
            },
            {
              "sourceId": "usd-al-ghabah",
              "locatorStatus": "complete",
              "volume": 5,
              "page": "439"
            }
          ]
        }
      ]
    },
    {
      "id": "khadijah.death",
      "kind": "death",
      "title": {
        "ar": "وفاتها"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "توفيت خديجة بمكة قبل خروج النبي ﷺ إلى المدينة بثلاث سنين، كما يروي عروة بن الزبير، وقال ابن الأثير: وهذا هو الصواب."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "complete",
              "hadithNumber": "3896"
            },
            {
              "sourceId": "usd-al-ghabah",
              "locatorStatus": "complete",
              "volume": 5,
              "page": "439"
            },
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "117"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وكانت وفاتها في رمضان، ودُفنت بالحجون، وقيل كانت يومئذ بنت خمس وستين سنة."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "111"
            },
            {
              "sourceId": "siyar",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "112"
            },
            {
              "sourceId": "tabaqat-ibn-sad",
              "locatorStatus": "complete",
              "volume": 8,
              "page": "14"
            },
            {
              "sourceId": "usd-al-ghabah",
              "locatorStatus": "complete",
              "volume": 5,
              "page": "439"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ويروي ابن سعد من طريق الواقدي عن حكيم بن حزام أنهم دفنوها بالحجون، وأن النبي ﷺ نزل في حفرتها، ولم تكن الصلاة على الجنازة قد شُرعت يومئذ."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "tabaqat-ibn-sad",
              "locatorStatus": "complete",
              "volume": 8,
              "page": "15"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وتوفي أبو طالب في العام نفسه، فتتابعت على النبي ﷺ المصائب بهلاكهما، على ما يذكر ابن إسحاق، ولذلك يُعرف ذلك العام بعام الحزن."
          },
          "reliability": "reported",
          "citations": [
            {
              "sourceId": "sirat-ibn-hisham",
              "locatorStatus": "complete",
              "volume": 1,
              "page": "416"
            },
            {
              "sourceId": "usd-al-ghabah",
              "locatorStatus": "complete",
              "volume": 5,
              "page": "439"
            }
          ]
        },
        {
          "type": "disputeNote",
          "text": {
            "ar": "واختُلف في أيّهما مات قبل الآخر."
          },
          "opinions": [
            {
              "text": {
                "ar": "ماتت خديجة قبل أبي طالب بشهر وخمسة أيام، على ما يذكر الواقدي."
              },
              "citations": [
                {
                  "sourceId": "siyar",
                  "locatorStatus": "complete",
                  "volume": 2,
                  "page": "112"
                }
              ]
            },
            {
              "text": {
                "ar": "ماتت بعد أبي طالب، على ما يرويه يونس بن بكير عن ابن إسحاق، ويقول الحاكم: بثلاثة أيام."
              },
              "citations": [
                {
                  "sourceId": "usd-al-ghabah",
                  "locatorStatus": "complete",
                  "volume": 5,
                  "page": "439"
                },
                {
                  "sourceId": "siyar",
                  "locatorStatus": "complete",
                  "volume": 2,
                  "page": "112"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "khadijah.lessons",
      "kind": "lessons",
      "title": {
        "ar": "دروس من سيرتها"
      },
      "blocks": [
        {
          "type": "lesson",
          "text": {
            "ar": "أن الزوجة الصالحة سند لزوجها في أشد ساعاته، تذكّره بما فيه من الخير وتعينه على الحق."
          },
          "basedOn": [
            "khadijah.first-believer"
          ]
        },
        {
          "type": "lesson",
          "text": {
            "ar": "وأن حسن الخلق شاهد لصاحبه؛ فقد استدلّت خديجة على أن الله لن يخزي النبي ﷺ بصلته الرحم وحمله الكَلّ وإعانته على نوائب الحق."
          },
          "basedOn": [
            "khadijah.first-believer"
          ]
        },
        {
          "type": "lesson",
          "text": {
            "ar": "وأن المال الصالح يُنفق في نصرة الحق، كما أنفقت خديجة مالها على النبي ﷺ وواسته به."
          },
          "basedOn": [
            "khadijah.support"
          ]
        },
        {
          "type": "lesson",
          "text": {
            "ar": "وأن الوفاء لأهل الفضل يبقى بعد موتهم، فقد بقي النبي ﷺ يذكرها ويكرم أهلها وصديقاتها."
          },
          "basedOn": [
            "khadijah.loyalty"
          ]
        }
      ]
    }
