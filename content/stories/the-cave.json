  "chapters": [
    {
      "id": "the-cave.1",
      "title": {
        "ar": "الخروج من مكة"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "أعدّ أبو بكر راحلتين للهجرة، وخرج مع النبي ﷺ من مكة إلى غارٍ في جبل ثور."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "pending"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "واستأجرا رجلًا هاديًا خبيرًا بالطريق، وكان على دين قريش، فدفعا إليه راحلتيهما وواعداه الغار بعد ثلاث ليال."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "pending"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وصنعت لهما أسماء بنت أبي بكر الزاد، فشقّت نطاقها لتربط به، فسُمّيت ذات النطاقين."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "pending"
            }
          ]
        }
      ]
    },
    {
      "id": "the-cave.2",
      "title": {
        "ar": "في الغار"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "مكثا في الغار ثلاث ليال، وكان عبد الله بن أبي بكر يبيت عندهما ثم يرجع إلى مكة قبل الفجر فيأتيهما بأخبار قريش."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "pending"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "وكان عامر بن فهيرة مولى أبي بكر يرعى الغنم قريبًا منهما، فيأتيهما باللبن."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "pending"
            }
          ]
        },
        {
          "type": "quranQuote",
          "ref": {
            "surah": 9,
            "ayahFrom": 40
          }
        },
        {
          "type": "hadithQuote",
          "textStatus": "pendingFromSource",
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "pending",
              "grading": {
                "grade": "sahih",
                "gradedBy": {
                  "ar": "البخاري، بإخراجه في صحيحه"
                }
              }
            },
            {
              "sourceId": "muslim",
              "locatorStatus": "pending",
              "grading": {
                "grade": "sahih",
                "gradedBy": {
                  "ar": "مسلم، بإخراجه في صحيحه"
                }
              }
            }
          ],
          "summary": {
            "ar": "حديث أبي بكر عمّا قاله للنبي ﷺ وهما في الغار، وما طمأنه به النبي ﷺ من معيّة الله لهما."
          }
        }
      ]
    },
    {
      "id": "the-cave.3",
      "title": {
        "ar": "الطريق إلى المدينة"
      },
      "blocks": [
        {
          "type": "paragraph",
          "text": {
            "ar": "ثم جاءهما الدليل بالراحلتين، فسلك بهما طريق الساحل."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "pending"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ولحق بهما في الطريق سراقة بن مالك طمعًا في جائزة قريش، ثم رجع عنهما."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "pending"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": {
            "ar": "ووصلا إلى المدينة، فاستقبلهما المسلمون."
          },
          "reliability": "established",
          "citations": [
            {
              "sourceId": "bukhari",
              "locatorStatus": "pending"
            }
          ]
        },
        {
          "type": "lesson",
          "text": {
            "ar": "في القصة أن الأخذ بالأسباب والتخطيط لا ينافي التوكل على الله."
          }
        }
      ]
    }
  ]
}
