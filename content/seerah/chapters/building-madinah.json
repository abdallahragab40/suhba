{
  "schemaVersion": 1,
  "id": "building-madinah",
  "title": {
    "ar": "بناء المجتمع في المدينة"
  },
  "abstract": {
    "ar": "المسجد النبوي، والمؤاخاة بين المهاجرين والأنصار، وتنظيم العلاقات في المدينة، والأذان، وتحويل القبلة."
  },
  "era": "madinan",
  "date": {
    "precision": "range",
    "era": "afterHijra",
    "hijriYear": 1,
    "gregorianYear": 622,
    "hijriYearEnd": 2,
    "gregorianYearEnd": 624
  },
  "references": [
    "sirat-ibn-hisham",
    "tabaqat-ibn-sad",
    "bukhari",
    "muslim"
  ],
  "eventIds": [
    "prophets-mosque",
