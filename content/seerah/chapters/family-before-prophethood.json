  "id": "family-before-prophethood",
  "title": {
    "ar": "الأسرة والحياة قبل البعثة"
  },
  "abstract": {
    "ar": "تجارته لخديجة وزواجه بها، وأولاده منها، وكفالته عليًّا وزيدًا، وتحبُّب الخلوة إليه في غار حراء."
  },
  "era": "preIslam",
  "date": {
    "precision": "range",
    "era": "beforeHijra",
    "hijriYear": 28,
    "gregorianYear": 595,
    "hijriYearEnd": 13,
    "gregorianYearEnd": 610
  },
