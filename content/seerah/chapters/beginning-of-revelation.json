{
  "schemaVersion": 1,
  "id": "beginning-of-revelation",
  "title": {
    "ar": "بدء الوحي"
  },
  "abstract": {
    "ar": "الرؤيا الصادقة، ونزول أوائل سورة العلق في غار حراء، وتثبيت خديجة، وشهادة ورقة، ثم فترة الوحي وأوائل سورة المدثر."
  },
  "era": "makkan",
  "date": {
    "precision": "approx",
    "era": "beforeHijra",
    "hijriYear": 13,
    "gregorianYear": 610
  },
  "references": [
    "sirat-ibn-hisham",
    "bukhari",
    "muslim",
    "al-bidaya"
  ],
  "eventIds": [
    "first-revelation"
  ],
  "placeIds": [
    "ghar-hira",
    "makkah"
  ],
  "visualIds": [
    "seerah-periods"
  ],
  "blocks": [
    {
      "type": "paragraph",
      "text": {
        "ar": "بُعث النبي ﷺ وهو ابن أربعين سنة. وكان أول ما بُدئ به من الوحي الرؤيا الصادقة في النوم، فكان لا يرى رؤيا إلا جاءت مثل فلق الصبح."
      },
      "reliability": "established",
      "citations": [
        {
          "sourceId": "bukhari",
          "locatorStatus": "complete",
          "hadithNumber": "3"
        },
        {
          "sourceId": "bukhari",
          "locatorStatus": "complete",
          "hadithNumber": "3851"
        },
        {
          "sourceId": "muslim",
          "locatorStatus": "complete",
          "hadithNumber": "160"
        },
        {
          "sourceId": "muslim",
          "locatorStatus": "complete",
          "hadithNumber": "2347"
        }
      ]
    },
    {
      "type": "paragraph",
      "text": {
        "ar": "وذكر النبي ﷺ أنه كان يعرف حجرًا بمكة كان يسلّم عليه قبل أن يُبعث، كما في صحيح مسلم."
      },
      "reliability": "established",
      "citations": [
        {
          "sourceId": "muslim",
          "locatorStatus": "complete",
          "hadithNumber": "2277"
        }
      ]
    },
    {
      "type": "paragraph",
      "text": {
        "ar": "ثم جاءه الملك وهو في غار حراء فأمره بالقراءة، فأخبره النبي ﷺ أنه ليس بقارئ، فضمّه الملك ضمًّا شديدًا ثلاث مرات، ثم قرأ عليه أوائل سورة العلق."
      },
      "reliability": "established",
      "citations": [
        {
          "sourceId": "bukhari",
          "locatorStatus": "complete",
          "hadithNumber": "3"
        },
        {
          "sourceId": "muslim",
          "locatorStatus": "complete",
          "hadithNumber": "160"
        }
      ]
    },
    {
      "type": "quranQuote",
      "ref": {
        "surah": 96,
        "ayahFrom": 1,
        "ayahTo": 5
      },
      "note": {
        "ar": "أول ما نزل من القرآن على الصحيح."
      }
    },
    {
      "type": "paragraph",
      "text": {
        "ar": "ورجع بها النبي ﷺ يرجف فؤاده، فدخل على خديجة وطلب أن يُغطّى، فغطّوه حتى ذهب عنه الروع، وأخبرها الخبر."
      },
      "reliability": "established",
      "citations": [
        {
          "sourceId": "bukhari",
          "locatorStatus": "complete",
          "hadithNumber": "3"
        }
      ]
    },
    {
      "type": "hadithQuote",
      "textStatus": "complete",
      "reliability": "established",
      "citations": [
        {
          "sourceId": "bukhari",
          "locatorStatus": "complete",
          "hadithNumber": "3",
          "grading": {
            "grade": "sahih",
            "gradedBy": {
              "ar": "البخاري، بإخراجه في صحيحه"
            }
          }
        },
        {
          "sourceId": "muslim",
          "locatorStatus": "complete",
          "hadithNumber": "160",
          "grading": {
            "grade": "sahih",
            "gradedBy": {
              "ar": "مسلم، بإخراجه في صحيحه"
            }
          }
        }
      ],
      "text": {
        "ar": "كَلاَّ وَاللَّهِ مَا يُخْزِيكَ اللَّهُ أَبَدًا، إِنَّكَ لَتَصِلُ الرَّحِمَ، وَتَحْمِلُ الْكَلَّ، وَتَكْسِبُ الْمَعْدُومَ، وَتَقْرِي الضَّيْفَ، وَتُعِينُ عَلَى نَوَائِبِ الْحَقِّ"
      },
      "summary": {
        "ar": "حديث عائشة في بدء الوحي، وفيه أن خديجة طمأنت النبي ﷺ بأن الله لن يخذله، واستدلّت على ذلك بصلته الرحم، وإعانته الضعيف والمحتاج، وإكرامه الضيف، ونصرته أهل الحق في الشدائد."
      }
    },
    {
      "type": "paragraph",
      "text": {
        "ar": "وانطلقت به خديجة إلى ابن عمها ورقة بن نوفل، وكان قد تنصّر في الجاهلية وقرأ الكتب، فأخبره أن الذي جاءه هو الناموس الذي نزل على موسى، وتمنّى أن يكون حيًّا حين يُخرجه قومه."
      },
      "reliability": "established",
      "citations": [
        {
          "sourceId": "bukhari",
          "locatorStatus": "complete",
          "hadithNumber": "3"
        }
      ]
    },
    {
      "type": "paragraph",
      "text": {
        "ar": "ثم فتر الوحي مدة، ثم تتابع بنزول أوائل سورة المدثر، وفيها الأمر بالإنذار."
      },
      "reliability": "established",
      "citations": [
        {
          "sourceId": "bukhari",
          "locatorStatus": "complete",
          "hadithNumber": "4"
        },
        {
          "sourceId": "quran",
          "locatorStatus": "complete",
          "quranRef": {
            "surah": 74,
            "ayahFrom": 1,
            "ayahTo": 5
          }
        }
      ]
    },
    {
      "type": "disputeNote",
      "text": {
        "ar": "واختلف أهل العلم في مدة فترة الوحي بعد النزول الأول."
      },
      "opinions": [
        {
          "text": {
            "ar": "أنها كانت أيامًا قليلة."
          },
          "citations": [
            {
              "sourceId": "al-bidaya",
              "locatorStatus": "pending"
            }
          ]
        },
        {
          "text": {
            "ar": "أنها طالت أشهرًا، وقيل أكثر من ذلك، والروايات في تحديدها غير قاطعة."
          },
          "citations": [
            {
              "sourceId": "al-bidaya",
              "locatorStatus": "complete",
              "volume": 4,
              "page": "42"
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "text": {
        "ar": "ثم رأى النبي ﷺ الملك الذي جاءه بحراء جالسًا على كرسي بين السماء والأرض، فرجع إلى أهله وطلب أن يُدثّر، فنزلت أوائل سورة المدثر بالأمر بالقيام والإنذار، وتطهير الثياب، وهجر الأوثان، والصبر لله."
      },
      "reliability": "established",
      "citations": [
        {
          "sourceId": "bukhari",
          "locatorStatus": "complete",
          "hadithNumber": "4"
        },
        {
          "sourceId": "muslim",
          "locatorStatus": "complete",
          "hadithNumber": "161"
        }
      ]
    },
    {
      "type": "quranQuote",
      "ref": {
        "surah": 74,
        "ayahFrom": 1,
        "ayahTo": 5
      }
    },
    {
      "type": "paragraph",
      "text": {
        "ar": "وكان نزول القرآن في شهر رمضان، كما دلّ عليه القرآن نفسه."
      },
      "reliability": "established",
      "citations": [
        {
          "sourceId": "quran",
          "locatorStatus": "complete",
          "quranRef": {
            "surah": 2,
            "ayahFrom": 185
          }
        },
        {
          "sourceId": "quran",
          "locatorStatus": "complete",
          "quranRef": {
            "surah": 97,
            "ayahFrom": 1
          }
        }
      ]
    },
    {
      "type": "paragraph",
      "text": {
        "ar": "وكان أول ما نزل يذكّر الإنسان بأنه مخلوق من علق، وبأن الله علّمه بالقلم ما لم يعلم، فكانت البداية تعريفًا بالخالق وتكريمًا للعلم."
      },
      "reliability": "established",
      "citations": [
        {
          "sourceId": "quran",
          "locatorStatus": "complete",
          "quranRef": {
            "surah": 96,
            "ayahFrom": 1,
            "ayahTo": 5
          }
        }
      ]
    },
    {
      "type": "paragraph",
      "text": {
        "ar": "وذكر النبي ﷺ أن يوم الاثنين هو اليوم الذي وُلد فيه واليوم الذي أُنزل عليه فيه."
      },
      "reliability": "established",
      "citations": [
        {
          "sourceId": "muslim",
          "locatorStatus": "complete",
          "hadithNumber": "1162"
        }
      ]
    },
    {
      "type": "heading",
      "text": {
        "ar": "كيف كان يأتيه الوحي"
      }
    },
    {
      "type": "paragraph",
      "text": {
        "ar": "وسأل الحارث بن هشام النبي ﷺ عن كيفية إتيان الوحي، فأخبر أنه يأتيه أحيانًا مثل صلصلة الجرس، وهو أشدّه عليه، فيفصم عنه وقد وعى ما قيل، وأحيانًا يتمثّل له الملك رجلًا فيكلّمه فيعي ما يقول."
      },
      "reliability": "established",
      "citations": [
        {
          "sourceId": "bukhari",
          "locatorStatus": "complete",
          "hadithNumber": "2"
        }
      ]
    },
    {
      "type": "paragraph",
      "text": {
        "ar": "وذكرت عائشة أنها رأته ينزل عليه الوحي في اليوم الشديد البرد، فيفصم عنه وإن جبينه ليتفصّد عرقًا، لما يجد من ثقله."
      },
      "reliability": "established",
      "citations": [
        {
          "sourceId": "bukhari",
          "locatorStatus": "complete",
          "hadithNumber": "2"
        },
        {
          "sourceId": "quran",
          "locatorStatus": "complete",
          "quranRef": {
            "surah": 73,
            "ayahFrom": 5
          }
        }
      ]
    },
    {
      "type": "paragraph",
      "text": {
        "ar": "وكان النبي ﷺ في أول الأمر يعالج من التنزيل شدة، فيحرّك به لسانه وشفتيه حرصًا على حفظه، فنزل أن الله تكفّل بجمعه في صدره وبيانه، فكان بعد ذلك إذا أتاه جبريل استمع، فإذا انطلق قرأه كما قرأه."
      },
      "reliability": "established",
      "citations": [
        {
          "sourceId": "bukhari",
          "locatorStatus": "complete",
          "hadithNumber": "5"
        },
        {
          "sourceId": "quran",
          "locatorStatus": "complete",
          "quranRef": {
            "surah": 75,
            "ayahFrom": 16,
            "ayahTo": 19
          }
        }
      ]
    },
    {
      "type": "paragraph",
      "text": {
        "ar": "وأُمر النبي ﷺ في أوائل ما نزل بقيام الليل، فكان يقوم هو وطائفة من أصحابه، حتى نزل التخفيف بعد ذلك في آخر سورة المزمّل."
      },
      "reliability": "established",
      "citations": [
        {
          "sourceId": "quran",
          "locatorStatus": "complete",
          "quranRef": {
            "surah": 73,
            "ayahFrom": 1,
            "ayahTo": 4
          }
        },
        {
          "sourceId": "quran",
          "locatorStatus": "complete",
          "quranRef": {
            "surah": 73,
            "ayahFrom": 20
          }
        },
        {
          "sourceId": "muslim",
          "locatorStatus": "complete",
          "hadithNumber": "746"
        }
      ]
    },
    {
      "type": "heading",
      "text": {
        "ar": "أثر البداية"
      }
    },
    {
      "type": "paragraph",
      "text": {
        "ar": "وكانت خديجة أول من آمن به وصدّقه، ثم آمن به أقرب الناس إليه ممن عرفوه عن قرب؛ إذ كان صدقه وأمانته معروفين لديهم قبل أن يحدّثهم بشيء."
      },
      "reliability": "reported",
      "citations": [
        {
          "sourceId": "sirat-ibn-hisham",
          "locatorStatus": "complete",
          "volume": 1,
          "page": "240"
        },
        {
          "sourceId": "tabaqat-ibn-sad",
          "locatorStatus": "complete",
          "volume": 8,
          "page": "13"
        }
      ]
    },
    {
      "type": "paragraph",
      "text": {
        "ar": "ولم يعش ورقة بن نوفل طويلًا بعد ذلك، ولكن ما تنبّأ به من أن قومه سيعادونه ويخرجونه تحقّق بعد سنين، حين اضطرّه أذى قريش إلى الهجرة."
      },
      "reliability": "established",
      "citations": [
        {
          "sourceId": "bukhari",
          "locatorStatus": "complete",
          "hadithNumber": "3"
        }
      ]
    },
    {
      "type": "paragraph",
      "text": {
        "ar": "ولم يكن النبي ﷺ يتطلّع إلى النبوة أو يرجوها، كما قال الله تعالى: وما كنت ترجو أن يُلقى إليك الكتاب إلا رحمة من ربك."
      },
      "reliability": "established",
      "citations": [
        {
          "sourceId": "quran",
          "locatorStatus": "complete",
          "quranRef": {
            "surah": 28,
            "ayahFrom": 86
          }
        }
      ]
    },
    {
      "type": "paragraph",
      "text": {
        "ar": "ثم تتابع الوحي منجّمًا بحسب الوقائع طوال ثلاث وعشرين سنة، ليثبّت به فؤاده ويعلّم الناس على مكث، كما ذكر القرآن."
      },
      "reliability": "established",
      "citations": [
        {
          "sourceId": "quran",
          "locatorStatus": "complete",
          "quranRef": {
            "surah": 17,
            "ayahFrom": 106
          }
        },
        {
          "sourceId": "quran",
          "locatorStatus": "complete",
          "quranRef": {
            "surah": 25,
            "ayahFrom": 32
          }
        }
      ]
    },
    {
      "type": "lesson",
      "text": {
        "ar": "جاءت أول كلمة من الوحي أمرًا بالقراءة باسم الله؛ فالعلم في هذا الدين يبدأ من الله ويعود إليه. ووقفت خديجة إلى جانب النبي ﷺ بكلمات استدلّت فيها بأخلاقه، فكان خلقه أول شاهد على صدقه."
      }
    },
    {
      "type": "lesson",
      "text": {
        "ar": "انتقل النبي ﷺ بالوحي من الخلوة إلى البلاغ، ومن التعبّد في الغار إلى دعوة الناس؛ فالعبادة الخاصة تُعدّ صاحبها لحمل الأمانة العامة."
      }
    }
  ],
