            "ayahTo": 5
          }
        }
      ]
    },
    {
      "type": "quranQuote",
      "ref": {
        "surah": 74,
        "ayahFrom": 1,
        "ayahTo": 5
      }
    },
    {
      "type": "paragraph",
      "text": {
        "ar": "وكان نزول القرآن في شهر رمضان، كما دلّ عليه القرآن نفسه."
      },
      "reliability": "established",
      "citations": [
        {
          "sourceId": "quran",
