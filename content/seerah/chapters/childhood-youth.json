  "id": "childhood-youth",
  "title": {
    "ar": "النشأة والشباب"
  },
  "abstract": {
    "ar": "من البادية في بني سعد إلى كفالة الجد ثم العم، ورعي الغنم، وشهود بناء الكعبة، وما عُرف به من الأمانة قبل البعثة."
  },
  "era": "preIslam",
  "date": {
    "precision": "range",
    "era": "beforeHijra",
    "hijriYear": 53,
    "gregorianYear": 570,
    "hijriYearEnd": 15,
    "gregorianYearEnd": 608
  },
  "references": [
