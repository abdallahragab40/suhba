  "id": "farewell-and-passing",
  "title": {
    "ar": "حجة الوداع والوفاة"
  },
  "abstract": {
    "ar": "حجة الوداع وخطبة عرفة ونزول آية إكمال الدين، ثم مرض النبي ﷺ ووفاته، وثبات أبي بكر يومها، مع ما اختُلف فيه من التاريخ."
  },
  "era": "madinan",
  "date": {
    "precision": "range",
    "era": "afterHijra",
    "hijriYear": 10,
    "gregorianYear": 632,
    "hijriYearEnd": 11,
    "gregorianYearEnd": 632
  },
  "references": [
