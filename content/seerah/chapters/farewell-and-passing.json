  ],
  "blocks": [
    {
      "type": "paragraph",
      "text": {
        "ar": "حجّ النبي ﷺ في السنة العاشرة حجته الوحيدة بعد الهجرة، وخرج معه جمع عظيم من المسلمين، ونقل جابر بن عبد الله صفة هذه الحجة نقلًا مفصّلًا."
      },
      "reliability": "established",
      "citations": [
        {
          "sourceId": "muslim",
          "locatorStatus": "complete",
          "hadithNumber": "1218"
        },
        {
          "sourceId": "bukhari",
          "locatorStatus": "complete",
          "hadithNumber": "4404"
        }
      ]
    },
    {
      "type": "paragraph",
      "text": {
        "ar": "وأعلن النبي ﷺ عزمه على الحج، فقدم المدينة بشر كثير كلهم يريد أن يأتمّ به، وجعل يعلّمهم المناسك ويأمرهم أن يأخذوها عنه."
      },
      "reliability": "established",
      "citations": [
        {
          "sourceId": "muslim",
          "locatorStatus": "complete",
          "hadithNumber": "1218"
        },
        {
          "sourceId": "muslim",
          "locatorStatus": "complete",
          "hadithNumber": "1297"
        }
      ]
    },
    {
      "type": "paragraph",
      "text": {
        "ar": "وجمع يوم عرفة بين الظهر والعصر، ثم وقف يدعو حتى غربت الشمس، ثم دفع إلى مزدلفة، ثم رمى ونحر بمنى، فنحر بيده ثلاثًا وستين بدنة وأكمل علي الباقي، كما في حديث جابر."
      },
      "reliability": "established",
      "citations": [
        {
          "sourceId": "muslim",
          "locatorStatus": "complete",
          "hadithNumber": "1218"
        }
      ]
    },
    {
      "type": "paragraph",
      "text": {
        "ar": "وخطب الناس يوم النحر بمنى، فسألهم عن اليوم والشهر والبلد، ثم بيّن أن دماءهم وأموالهم وأعراضهم حرام عليهم كحرمة يومهم ذاك، وأمر الشاهد أن يبلّغ الغائب."
      },
      "reliability": "established",
      "citations": [
        {
          "sourceId": "bukhari",
          "locatorStatus": "complete",
          "hadithNumber": "1739"
        },
        {
          "sourceId": "bukhari",
          "locatorStatus": "complete",
          "hadithNumber": "1741"
        }
      ]
    },
    {
      "type": "hadithQuote",
      "textStatus": "complete",
      "reliability": "established",
      "citations": [
        {
          "sourceId": "muslim",
          "locatorStatus": "complete",
          "hadithNumber": "1218",
          "grading": {
            "grade": "sahih",
            "gradedBy": {
              "ar": "مسلم، بإخراجه في صحيحه"
            }
          }
        }
      ],
      "text": {
        "ar": "إِنَّ دِمَاءَكُمْ وَأَمْوَالَكُمْ حَرَامٌ عَلَيْكُمْ كَحُرْمَةِ يَوْمِكُمْ هَذَا فِي شَهْرِكُمْ هَذَا فِي بَلَدِكُمْ هَذَا أَلاَ كُلُّ شَىْءٍ مِنْ أَمْرِ الْجَاهِلِيَّةِ تَحْتَ قَدَمَىَّ مَوْضُوعٌ وَدِمَاءُ الْجَاهِلِيَّةِ مَوْضُوعَةٌ وَإِنَّ أَوَّلَ دَمٍ أَضَعُ مِنْ دِمَائِنَا دَمُ ابْنِ رَبِيعَةَ بْنِ الْحَارِثِ كَانَ مُسْتَرْضِعًا فِي بَنِي سَعْدٍ فَقَتَلَتْهُ هُذَيْلٌ وَرِبَا الْجَاهِلِيَّةِ مَوْضُوعٌ وَأَوَّلُ رِبًا أَضَعُ رِبَانَا رِبَا عَبَّاسِ بْنِ عَبْدِ الْمُطَّلِبِ فَإِنَّهُ مَوْضُوعٌ كُلُّهُ"
      },
      "summary": {
        "ar": "حديث جابر في صفة حجة النبي ﷺ، وفيه خطبته بعرفة: حرمة الدماء والأموال، ووضع ربا الجاهلية ودمائها، والوصية بالنساء، والاعتصام بكتاب الله."
      }
    },
    {
      "type": "paragraph",
      "text": {
        "ar": "ونزل على النبي ﷺ يوم عرفة، وكان يوم جمعة، قوله تعالى: اليوم أكملت لكم دينكم."
      },
      "reliability": "established",
      "citations": [
        {
          "sourceId": "bukhari",
          "locatorStatus": "complete",
          "hadithNumber": "45"
        },
        {
          "sourceId": "quran",
          "locatorStatus": "complete",
          "quranRef": {
            "surah": 5,
            "ayahFrom": 3
          }
        }
      ]
    },
    {
      "type": "quranQuote",
      "ref": {
        "surah": 5,
        "ayahFrom": 3
      }
    },
    {
      "type": "heading",
      "text": {
        "ar": "المرض"
      }
    },
    {
      "type": "paragraph",
      "text": {
        "ar": "ثم رجع إلى المدينة، وبدأ به المرض بعد ذلك بنحو شهرين، في آخر صفر أو أول ربيع الأول على ما يذكره أهل السير."
      },
      "reliability": "reported",
      "citations": [
        {
          "sourceId": "sirat-ibn-hisham",
          "locatorStatus": "complete",
          "volume": 2,
          "page": "642"
        },
        {
          "sourceId": "tabaqat-ibn-sad",
          "locatorStatus": "complete",
          "volume": 2,
          "page": "208"
        }
      ]
    },
    {
      "type": "paragraph",
      "text": {
        "ar": "وكان قد جهّز جيشًا بإمرة أسامة بن زيد، فطعن بعض الناس في إمارته فأقرّها وذكر أنه لخليق بها، وصلّى في مرضه قاعدًا وأبو بكر إلى جنبه قائمًا يقتدي به، والناس يقتدون بأبي بكر."
      },
      "reliability": "established",
      "citations": [
        {
          "sourceId": "bukhari",
          "locatorStatus": "complete",
          "hadithNumber": "4469"
        },
        {
          "sourceId": "bukhari",
          "locatorStatus": "complete",
          "hadithNumber": "713"
        }
      ]
    },
    {
      "type": "paragraph",
      "text": {
        "ar": "وخطب في مرضه فذكر أن عبدًا خيّره الله بين الدنيا وما عنده فاختار ما عند الله، فبكى أبو بكر وفهم مراده، وأمر بسدّ الأبواب إلى المسجد إلا باب أبي بكر."
      },
      "reliability": "established",
      "citations": [
        {
          "sourceId": "bukhari",
          "locatorStatus": "complete",
          "hadithNumber": "3654"
        },
        {
          "sourceId": "muslim",
          "locatorStatus": "complete",
          "hadithNumber": "2382"
        }
      ]
    },
    {
      "type": "paragraph",
      "text": {
        "ar": "ودعا ابنته فاطمة فأسرّ إليها فبكت، ثم أسرّ إليها فضحكت، فلما سُئلت بعد وفاته ذكرت أنه أخبرها أنه يُقبض في وجعه ذلك، ثم أخبرها أنها أول أهله لحاقًا به."
      },
      "reliability": "established",
      "citations": [
        {
          "sourceId": "bukhari",
          "locatorStatus": "complete",
          "hadithNumber": "3624"
        },
        {
          "sourceId": "muslim",
          "locatorStatus": "complete",
          "hadithNumber": "2450"
        }
      ]
    },
    {
      "type": "paragraph",
      "text": {
        "ar": "واشتد عليه المرض، فاستأذن أزواجه أن يُمرّض في بيت عائشة فأذنّ له، وأمر أبا بكر أن يصلي بالناس."
      },
      "reliability": "established",
      "citations": [
        {
          "sourceId": "bukhari",
          "locatorStatus": "complete",
          "hadithNumber": "665"
        },
        {
          "sourceId": "bukhari",
          "locatorStatus": "complete",
          "hadithNumber": "664"
        },
        {
          "sourceId": "muslim",
          "locatorStatus": "complete",
          "hadithNumber": "418"
        }
      ]
    },
    {
      "type": "paragraph",
      "text": {
        "ar": "وفي صبيحة يوم الاثنين كشف ستر حجرته ينظر إلى المسلمين وهم صفوف في صلاة الفجر خلف أبي بكر، فتبسّم ضاحكًا، وظنّ الناس أنه خارج إليهم، فأشار إليهم أن أتمّوا صلاتكم، وأرخى الستر."
      },
      "reliability": "established",
      "citations": [
        {
          "sourceId": "bukhari",
          "locatorStatus": "complete",
          "hadithNumber": "680"
        },
        {
          "sourceId": "muslim",
          "locatorStatus": "complete",
          "hadithNumber": "419"
        }
      ]
    },
    {
      "type": "paragraph",
      "text": {
        "ar": "ودخل عبد الرحمن بن أبي بكر ومعه سواك، فأخذته عائشة فليّنته وأعطته إياه فاستنّ به، وكان آخر ما سُمع منه أن يكون مع الرفيق الأعلى."
      },
      "reliability": "established",
      "citations": [
        {
          "sourceId": "bukhari",
          "locatorStatus": "complete",
          "hadithNumber": "4438"
        }
      ]
    },
    {
      "type": "heading",
      "text": {
        "ar": "الوفاة"
      }
    },
    {
      "type": "paragraph",
      "text": {
        "ar": "وتوفي ﷺ يوم الاثنين في شهر ربيع الأول من السنة الحادية عشرة، وهو ابن ثلاث وستين سنة على الصحيح."
      },
      "reliability": "established",
      "citations": [
        {
          "sourceId": "bukhari",
          "locatorStatus": "complete",
          "hadithNumber": "1387"
        },
        {
          "sourceId": "bukhari",
          "locatorStatus": "complete",
          "hadithNumber": "3536"
        },
        {
          "sourceId": "muslim",
          "locatorStatus": "complete",
          "hadithNumber": "2348"
        }
      ]
    },
    {
      "type": "disputeNote",
      "text": {
        "ar": "واختلفوا في اليوم من الشهر."
      },
      "opinions": [
        {
          "text": {
            "ar": "الثاني عشر من ربيع الأول، وهو المشهور عند ابن إسحاق."
          },
          "citations": [
            {
              "sourceId": "al-bidaya",
              "locatorStatus": "complete",
              "volume": 8,
              "page": "107"
            },
            {
              "sourceId": "tarikh-al-tabari",
              "locatorStatus": "complete",
              "volume": 3,
              "page": "215"
            }
          ]
        },
        {
          "text": {
            "ar": "أيام أخرى من أوائل الشهر، ذكرها ابن سعد وغيره، وناقشها ابن كثير."
          },
          "citations": [
            {
              "sourceId": "tabaqat-ibn-sad",
              "locatorStatus": "complete",
              "volume": 2,
              "page": "208"
            },
            {
              "sourceId": "al-bidaya",
              "locatorStatus": "complete",
              "volume": 8,
              "page": "106"
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "text": {
        "ar": "واضطرب الناس لخبر وفاته، فجاء أبو بكر فكشف عن وجهه وقبّله، ثم خرج إلى الناس فذكّرهم بأن من كان يعبد الله فإن الله حي لا يموت، وتلا قوله تعالى: وما محمد إلا رسول قد خلت من قبله الرسل."
      },
      "reliability": "established",
      "citations": [
        {
          "sourceId": "bukhari",
          "locatorStatus": "complete",
          "hadithNumber": "3667"
        },
        {
          "sourceId": "quran",
          "locatorStatus": "complete",
          "quranRef": {
            "surah": 3,
            "ayahFrom": 144
          }
        }
      ]
    },
    {
      "type": "quranQuote",
      "ref": {
        "surah": 3,
        "ayahFrom": 144
      }
    },
    {
      "type": "paragraph",
      "text": {
        "ar": "ودُفن ﷺ في حجرة عائشة حيث توفي، وبايع المسلمون أبا بكر خليفة له."
      },
      "reliability": "reported",
      "citations": [
        {
          "sourceId": "tirmidhi",
          "locatorStatus": "complete",
          "hadithNumber": "1018"
        },
        {
          "sourceId": "bukhari",
          "locatorStatus": "complete",
          "hadithNumber": "1389"
        },
        {
          "sourceId": "bukhari",
          "locatorStatus": "complete",
          "hadithNumber": "3668"
        }
      ]
    },
    {
      "type": "paragraph",
      "text": {
        "ar": "وغسّله أهل بيته وعليه قميصه، ثم صلّى عليه المسلمون أرسالًا: الرجال ثم النساء ثم الصبيان، بغير إمام، على ما يذكره أهل السير."
      },
      "reliability": "reported",
      "citations": [
        {
          "sourceId": "sirat-ibn-hisham",
          "locatorStatus": "complete",
          "volume": 2,
          "page": "663"
        },
        {
          "sourceId": "tabaqat-ibn-sad",
          "locatorStatus": "complete",
          "volume": 2,
          "page": "221"
        }
      ]
    },
    {
      "type": "paragraph",
      "text": {
        "ar": "ولم يترك النبي ﷺ عند موته دينارًا ولا درهمًا ولا عبدًا ولا أمة، وتوفي ودرعه مرهونة عند يهودي في ثلاثين صاعًا من شعير."
      },
      "reliability": "established",
      "citations": [
        {
          "sourceId": "bukhari",
          "locatorStatus": "complete",
          "hadithNumber": "2739"
        },
        {
          "sourceId": "bukhari",
          "locatorStatus": "complete",
          "hadithNumber": "2916"
        }
      ]
    },
    {
      "type": "paragraph",
      "text": {
        "ar": "وكان من وصاياه في مرضه الوصية بالصلاة، وبالإحسان إلى من تحت أيدي الناس من الضعفاء، على ما في روايات السنن."
      },
      "reliability": "reported",
      "citations": [
        {
          "sourceId": "abu-dawud",
          "locatorStatus": "complete",
          "hadithNumber": "5156"
        }
      ]
    },
    {
      "type": "paragraph",
      "text": {
        "ar": "وكانت مدة نبوته ثلاثًا وعشرين سنة: ثلاث عشرة بمكة وعشرًا بالمدينة، كما في حديث ابن عباس."
      },
      "reliability": "established",
      "citations": [
        {
          "sourceId": "bukhari",
          "locatorStatus": "complete",
          "hadithNumber": "3902"
        }
      ]
    },
    {
      "type": "infographic",
      "visualId": "arafat-panel"
    },
    {
      "type": "lesson",
      "text": {
        "ar": "ختم النبي ﷺ حياته بإكمال البلاغ ووصايا جامعة في الحقوق والحرمات؛ وكان ثبات أبي بكر يوم الوفاة تعليمًا للأمة أن الرسالة باقية بعد صاحبها."
      }
    },
    {
      "type": "lesson",
      "text": {
        "ar": "وفي تبسّمه وهو يرى أصحابه صفوفًا خلف أبي بكر طمأنينة إلى أن الأمانة قد بُلّغت، وأن الجماعة قائمة بعده."
      }
    }
  ],
