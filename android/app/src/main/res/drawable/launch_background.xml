<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen before Android 12: the brand mark centred on the app's
     background colour. Android 12+ uses the splash attributes in values-v31. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_mark" />
    </item>
</layer-list>
