      "name": "review_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"review_items\" (\"question_key\" TEXT NOT NULL, \"box\" INTEGER NOT NULL CHECK(\"box\" BETWEEN 1 AND 5), \"due_on\" INTEGER NOT NULL, \"last_answered_at\" INTEGER NOT NULL, \"times_right\" INTEGER NOT NULL CHECK(\"times_right\" >= 0), \"times_wrong\" INTEGER NOT NULL CHECK(\"times_wrong\" >= 0), PRIMARY KEY (\"question_key\"));"
