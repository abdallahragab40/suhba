        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"reading_progress_entries\" (\"target_type\" TEXT NOT NULL, \"target_id\" TEXT NOT NULL, \"parent_id\" TEXT NOT NULL, \"fraction\" REAL NOT NULL, \"completed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"completed\" IN (0, 1)), \"content_version\" TEXT NOT NULL, \"updated_at\" INTEGER NOT NULL, \"target_revision\" TEXT NULL, \"block_index\" INTEGER NULL, \"block_offset\" REAL NULL, PRIMARY KEY (\"target_type\", \"target_id\"));"
        }
      ]
    },
