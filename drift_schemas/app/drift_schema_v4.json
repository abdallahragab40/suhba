          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"bookmarks\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"target_type\" TEXT NOT NULL, \"target_id\" TEXT NOT NULL, \"parent_id\" TEXT NULL, \"created_at\" INTEGER NOT NULL, UNIQUE (\"target_type\", \"target_id\"));"
